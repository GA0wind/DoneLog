import { StorageUtils, Label, Event, AccountEntry, AutoRenewal, LabelBudgetSetting } from './storage.uts'

export type LabelKind = 'event' | 'account'

type DefaultLabel = {
  name: string
  color: string
}

type LabelIdMigration = {
  oldId: number
  newId: number
}

/**
 * 标签管理工具类
 */
export class LabelManager {
  private static nextEventLabelId: number = 1
  private static nextAccountLabelId: number = 10001
  private static readonly accountLabelIdBase = 10000
  private static readonly defaultLabelsVersion = 1
  private static readonly defaultEventLabels: DefaultLabel[] = [
    { name: '工作', color: '#1F7A72' },
    { name: '学习', color: '#5D7FA3' },
    { name: '健康', color: '#8AB17D' },
    { name: '家务', color: '#E9C46A' },
    { name: '生活', color: '#E07A5F' },
    { name: '重要', color: '#B56576' },
    { name: '纪念日', color: '#6D597A' }
  ]
  private static readonly defaultAccountLabels: DefaultLabel[] = [
    { name: '餐饮', color: '#E07A5F' },
    { name: '交通', color: '#2A9D8F' },
    { name: '购物', color: '#B56576' },
    { name: '居家', color: '#8AB17D' },
    { name: '医疗', color: '#D45D79' },
    { name: '娱乐', color: '#6D597A' },
    { name: '学习', color: '#5D7FA3' },
    { name: '收入', color: '#1F7A72' }
  ]

  /**
   * 初始化ID
   */
  static initIds(): void {
    this.resetDefaultLabelsIfNeeded()
    this.normalizeLabels('event')
    this.normalizeLabels('account')
    this.sanitizeAllLabelReferences()

    const eventLabels = StorageUtils.getEventLabels()
    if (eventLabels.length > 0) {
      this.nextEventLabelId = Math.max(...eventLabels.map(l => l.id)) + 1
    }

    const accountLabels = StorageUtils.getAccountLabels()
    if (accountLabels.length > 0) {
      this.nextAccountLabelId = Math.max(this.accountLabelIdBase + 1, Math.max(...accountLabels.map(l => l.id)) + 1)
    } else {
      this.nextAccountLabelId = this.accountLabelIdBase + 1
    }
  }

  static resetDefaultLabels(kind: LabelKind): boolean {
    const labels = this.buildDefaultLabels(kind)
    const saveSuccess = this.saveLabelsByKind(kind, labels)
    if (!saveSuccess) return false

    const cleanSuccess = this.clearLabelReferences(kind)
    this.refreshNextId(kind)
    return cleanSuccess
  }

  static resetAllDefaultLabels(): boolean {
    const eventSuccess = this.resetDefaultLabels('event')
    const accountSuccess = this.resetDefaultLabels('account')
    if (eventSuccess && accountSuccess) {
      const meta = StorageUtils.getAppMeta()
      StorageUtils.saveAppMeta({
        ...meta,
        defaultLabelsVersion: this.defaultLabelsVersion
      })
      return true
    }
    return false
  }

  static repairLabelData(): boolean {
    this.resetDefaultLabelsIfNeeded()
    this.normalizeLabels('event')
    this.normalizeLabels('account')
    const cleanSuccess = this.sanitizeAllLabelReferences()
    this.refreshNextId('event')
    this.refreshNextId('account')
    return cleanSuccess
  }

  /**
   * 获取排序后的标签列表
   */
  static getSortedLabels(kind: LabelKind = 'event'): Label[] {
    const labels = this.getLabelsByKind(kind)
    return labels.sort((a, b) => a.sortOrder - b.sortOrder)
  }

  /**
   * 添加标签
   */
  static addLabel(name: string, color: string = '#007AFF', kind: LabelKind = 'event'): boolean {
    const labels = this.getLabelsByKind(kind)
    const normalized = name.trim()
    if (normalized.length === 0) return false

    if (this.isLabelNameDuplicate(normalized, kind)) return false

    const maxSortOrder = labels.length > 0 ? Math.max(...labels.map(l => l.sortOrder)) : 0

    const newLabel: Label = {
      id: kind == 'event' ? this.nextEventLabelId++ : this.getNextAccountLabelId(),
      name: normalized,
      color: color,
      sortOrder: maxSortOrder + 1
    }

    labels.push(newLabel)
    return this.saveLabelsByKind(kind, labels)
  }

  /**
   * 更新标签
   */
  static updateLabel(label: Label, kind: LabelKind = 'event'): boolean {
    const labels = this.getLabelsByKind(kind)
    const index = labels.findIndex(l => l.id == label.id)
    if (index === -1) return false

    const normalized = label.name.trim()
    if (normalized.length === 0) return false

    if (this.isLabelNameDuplicate(normalized, kind, label.id)) return false

    labels[index] = {
      ...labels[index],
      name: normalized,
      color: label.color
    }
    return this.saveLabelsByKind(kind, labels)
  }

  /**
   * 删除标签
   */
  static deleteLabel(labelId: number, kind: LabelKind = 'event'): boolean {
    const labels = this.getLabelsByKind(kind)
    const index = labels.findIndex(l => l.id == labelId)
    if (index === -1) return false

    labels.splice(index, 1)
    const saveLabelSuccess = this.saveLabelsByKind(kind, labels)
    if (!saveLabelSuccess) return false

    if (kind == 'event') {
      const events = StorageUtils.getEvents()
      const updatedEvents = events.map((event): Event => {
        const labelIds = event.labelIdList
          .split(',')
          .map(id => parseInt(id))
          .filter(id => !Number.isNaN(id) && id != labelId)

        return {
          id: event.id,
          name: event.name,
          labelIdList: labelIds.join(','),
          intervalDays: event.intervalDays,
          repeatUnit: event.repeatUnit,
          nextDueDate: event.nextDueDate,
          remark: event.remark,
          isTerminated: event.isTerminated,
          terminatedAt: event.terminatedAt,
          notifyEnabled: event.notifyEnabled,
          notifyTime: event.notifyTime,
          createTime: event.createTime,
          updateTime: event.updateTime
        }
      })

      return StorageUtils.saveEvents(updatedEvents)
    }

    const entries = StorageUtils.getAccountEntries()
    const updatedEntries = entries.map((entry): AccountEntry => {
      const labelIds = entry.labelIdList
        .split(',')
        .map(id => parseInt(id))
        .filter(id => !Number.isNaN(id) && id != labelId)

      return {
        id: entry.id,
        type: entry.type,
        amount: entry.amount,
        labelIdList: labelIds.join(','),
        paymentMethodId: entry.paymentMethodId,
        autoRenewalId: entry.autoRenewalId,
        remark: entry.remark,
        occurredAt: entry.occurredAt,
        createTime: entry.createTime,
        updateTime: entry.updateTime
      }
    })
    const saveEntriesSuccess = StorageUtils.saveAccountEntries(updatedEntries)
    if (!saveEntriesSuccess) return false
    const renewals = StorageUtils.getAutoRenewals()
    const updatedRenewals = renewals.map((renewal): AutoRenewal => ({
      ...renewal,
      labelIdList: this.removeLabelIdFromList(renewal.labelIdList, labelId),
      updateTime: Date.now()
    }))
    if (!StorageUtils.saveAutoRenewals(updatedRenewals)) return false
    return this.removeAccountLabelBudget(labelId)
  }

  /**
   * 更新标签排序
   */
  static updateLabelOrder(labelId: number, newOrder: number, kind: LabelKind = 'event'): boolean {
    const labels = this.getLabelsByKind(kind)
    const label = labels.find(l => l.id == labelId)
    if (label == null) return false

    const oldOrder = label.sortOrder
    if (oldOrder === newOrder) return true

    // 更新其他标签的排序
    labels.forEach(l => {
      if (l.id != labelId) {
        if (newOrder > oldOrder) {
          if (l.sortOrder > oldOrder && l.sortOrder <= newOrder) {
            l.sortOrder--
          }
        } else {
          if (l.sortOrder >= newOrder && l.sortOrder < oldOrder) {
            l.sortOrder++
          }
        }
      }
    })

    label.sortOrder = newOrder
    return this.saveLabelsByKind(kind, labels)
  }

  /**
   * 获取单个标签
   */
  static getLabelById(labelId: number, kind: LabelKind = 'event'): Label | null {
    const labels = this.getLabelsByKind(kind)
    const label = labels.find(l => l.id == labelId)
    return label != null ? label : null
  }

  static getLabelByName(name: string, kind: LabelKind = 'event'): Label | null {
    const normalized = name.trim()
    if (normalized.length === 0) return null

    const labels = this.getLabelsByKind(kind)
    const label = labels.find(item => item.name == normalized)
    return label != null ? label : null
  }

  static isLabelNameDuplicate(name: string, kind: LabelKind = 'event', excludeId: number = 0): boolean {
    const normalized = name.trim()
    if (normalized.length === 0) return false

    const labels = this.getLabelsByKind(kind)
    return labels.some(label => label.id != excludeId && label.name == normalized)
  }

  static mergeLabels(sourceLabelId: number, targetLabelId: number, kind: LabelKind = 'event'): boolean {
    if (sourceLabelId == targetLabelId) return false

    const labels = this.getLabelsByKind(kind)
    const source = labels.find(label => label.id == sourceLabelId)
    const target = labels.find(label => label.id == targetLabelId)
    if (source == null || target == null) return false

    if (kind == 'event') {
      const events = StorageUtils.getEvents()
      const updatedEvents = events.map((event): Event => ({
        id: event.id,
        name: event.name,
        labelIdList: this.replaceLabelIdList(event.labelIdList, sourceLabelId, targetLabelId),
        intervalDays: event.intervalDays,
        repeatUnit: event.repeatUnit,
        nextDueDate: event.nextDueDate,
        remark: event.remark,
        isTerminated: event.isTerminated,
        terminatedAt: event.terminatedAt,
        notifyEnabled: event.notifyEnabled,
        notifyTime: event.notifyTime,
        createTime: event.createTime,
        updateTime: event.updateTime
      }))
      if (!StorageUtils.saveEvents(updatedEvents)) return false
    } else {
      const entries = StorageUtils.getAccountEntries()
      const updatedEntries = entries.map((entry): AccountEntry => ({
        id: entry.id,
        type: entry.type,
        amount: entry.amount,
        labelIdList: this.replaceLabelIdList(entry.labelIdList, sourceLabelId, targetLabelId),
        paymentMethodId: entry.paymentMethodId,
        autoRenewalId: entry.autoRenewalId,
        remark: entry.remark,
        occurredAt: entry.occurredAt,
        createTime: entry.createTime,
        updateTime: entry.updateTime
      }))
      if (!StorageUtils.saveAccountEntries(updatedEntries)) return false
      const renewals = StorageUtils.getAutoRenewals()
      const updatedRenewals = renewals.map((renewal): AutoRenewal => ({
        ...renewal,
        labelIdList: this.replaceLabelIdList(renewal.labelIdList, sourceLabelId, targetLabelId),
        updateTime: Date.now()
      }))
      if (!StorageUtils.saveAutoRenewals(updatedRenewals)) return false
      if (!this.mergeAccountLabelBudget(sourceLabelId, targetLabelId)) return false
    }

    const remainingLabels = labels
      .filter(label => label.id != sourceLabelId)
      .sort((a, b) => a.sortOrder - b.sortOrder)
      .map((label, index): Label => ({
        id: label.id,
        name: label.name,
        color: label.color,
        sortOrder: index + 1
      }))

    return this.saveLabelsByKind(kind, remainingLabels)
  }

  /**
   * 根据ID列表获取标签
   */
  static getLabelsByIds(labelIds: number[], kind: LabelKind = 'event'): Label[] {
    const labels = this.getLabelsByKind(kind)
    return labels.filter(l => labelIds.includes(l.id))
  }

  private static getLabelsByKind(kind: LabelKind): Label[] {
    return kind == 'event' ? StorageUtils.getEventLabels() : StorageUtils.getAccountLabels()
  }

  private static saveLabelsByKind(kind: LabelKind, labels: Label[]): boolean {
    return kind == 'event' ? StorageUtils.saveEventLabels(labels) : StorageUtils.saveAccountLabels(labels)
  }

  private static resetDefaultLabelsIfNeeded(): void {
    const meta = StorageUtils.getAppMeta()
    if (meta.defaultLabelsVersion >= this.defaultLabelsVersion) {
      return
    }

    const eventSuccess = this.resetDefaultLabels('event')
    const accountSuccess = this.resetDefaultLabels('account')
    if (eventSuccess && accountSuccess) {
      StorageUtils.saveAppMeta({
        ...meta,
        defaultLabelsVersion: this.defaultLabelsVersion
      })
    }
  }

  private static buildDefaultLabels(kind: LabelKind): Label[] {
    const defaults = kind == 'event' ? this.defaultEventLabels : this.defaultAccountLabels
    return defaults.map((item, index): Label => ({
      id: kind == 'event' ? index + 1 : this.accountLabelIdBase + index + 1,
      name: item.name,
      color: item.color,
      sortOrder: index + 1
    }))
  }

  private static refreshNextId(kind: LabelKind): void {
    const labels = this.getLabelsByKind(kind)
    const nextId = labels.length > 0 ? Math.max(...labels.map(label => label.id)) + 1 : 1
    if (kind == 'event') {
      this.nextEventLabelId = nextId
    } else {
      this.nextAccountLabelId = Math.max(this.accountLabelIdBase + 1, nextId)
    }
  }

  private static getNextAccountLabelId(): number {
    if (this.nextAccountLabelId <= this.accountLabelIdBase) {
      this.nextAccountLabelId = this.accountLabelIdBase + 1
    }
    const nextId = this.nextAccountLabelId
    this.nextAccountLabelId += 1
    return nextId
  }

  private static clearLabelReferences(kind: LabelKind): boolean {
    if (kind == 'event') {
      const events = StorageUtils.getEvents()
      const updatedEvents = events.map((event): Event => ({
        id: event.id,
        name: event.name,
        labelIdList: '',
        intervalDays: event.intervalDays,
        repeatUnit: event.repeatUnit,
        nextDueDate: event.nextDueDate,
        remark: event.remark,
        isTerminated: event.isTerminated,
        terminatedAt: event.terminatedAt,
        notifyEnabled: event.notifyEnabled,
        notifyTime: event.notifyTime,
        createTime: event.createTime,
        updateTime: event.updateTime
      }))
      return StorageUtils.saveEvents(updatedEvents)
    }

    const entries = StorageUtils.getAccountEntries()
    const updatedEntries = entries.map((entry): AccountEntry => ({
      id: entry.id,
      type: entry.type,
      amount: entry.amount,
      labelIdList: '',
      paymentMethodId: entry.paymentMethodId,
      autoRenewalId: entry.autoRenewalId,
      remark: entry.remark,
      occurredAt: entry.occurredAt,
      createTime: entry.createTime,
      updateTime: entry.updateTime
    }))
    const saveEntriesSuccess = StorageUtils.saveAccountEntries(updatedEntries)
    if (!saveEntriesSuccess) return false
    const renewals = StorageUtils.getAutoRenewals()
    const updatedRenewals = renewals.map((renewal): AutoRenewal => ({
      ...renewal,
      labelIdList: '',
      updateTime: Date.now()
    }))
    if (!StorageUtils.saveAutoRenewals(updatedRenewals)) return false
    return this.clearAccountLabelBudgets()
  }

  private static removeAccountLabelBudget(labelId: number): boolean {
    const settings = StorageUtils.getBudgetSettings()
    const nextBudgets = settings.labelMonthlyBudgets.filter(item => item.labelId != labelId)
    if (nextBudgets.length === settings.labelMonthlyBudgets.length) {
      return true
    }

    return StorageUtils.saveBudgetSettings({
      ...settings,
      labelMonthlyBudgets: nextBudgets,
      updateTime: Date.now()
    })
  }

  private static mergeAccountLabelBudget(sourceLabelId: number, targetLabelId: number): boolean {
    const settings = StorageUtils.getBudgetSettings()
    const sourceBudget = settings.labelMonthlyBudgets.find(item => item.labelId == sourceLabelId)
    const targetBudget = settings.labelMonthlyBudgets.find(item => item.labelId == targetLabelId)
    const nextBudgets = settings.labelMonthlyBudgets
      .filter(item => item.labelId != sourceLabelId && item.labelId != targetLabelId)

    if (targetBudget != null) {
      nextBudgets.push(targetBudget)
    } else if (sourceBudget != null) {
      nextBudgets.push({
        labelId: targetLabelId,
        amount: sourceBudget.amount
      })
    }

    nextBudgets.sort((a, b) => a.labelId - b.labelId)

    return StorageUtils.saveBudgetSettings({
      ...settings,
      labelMonthlyBudgets: nextBudgets,
      updateTime: Date.now()
    })
  }

  private static clearAccountLabelBudgets(): boolean {
    const settings = StorageUtils.getBudgetSettings()
    if (settings.labelMonthlyBudgets.length === 0) {
      return true
    }

    const emptyBudgets: LabelBudgetSetting[] = []

    return StorageUtils.saveBudgetSettings({
      ...settings,
      labelMonthlyBudgets: emptyBudgets,
      updateTime: Date.now()
    })
  }

  private static replaceLabelIdList(labelIdList: string, sourceLabelId: number, targetLabelId: number): string {
    if (labelIdList.length === 0) return ''

    const nextIds: number[] = []
    labelIdList
      .split(',')
      .map(id => parseInt(id))
      .filter(id => !Number.isNaN(id))
      .forEach(id => {
        const nextId = id == sourceLabelId ? targetLabelId : id
        if (nextIds.includes(nextId) == false) {
          nextIds.push(nextId)
        }
      })

    return nextIds.join(',')
  }

  private static removeLabelIdFromList(labelIdList: string, labelId: number): string {
    if (labelIdList.length === 0) return ''

    return labelIdList
      .split(',')
      .map(id => parseInt(id))
      .filter(id => !Number.isNaN(id) && id != labelId)
      .join(',')
  }

  private static getInitialNextLabelId(kind: LabelKind, labels: Label[]): number {
    const nextId = labels.length > 0 ? Math.max(...labels.map(label => label.id)) + 1 : 1
    if (kind == 'event') {
      return Math.max(1, nextId)
    }
    return Math.max(this.accountLabelIdBase + 1, nextId)
  }

  private static resolveMigratedLabelId(labelId: number, migrations: LabelIdMigration[]): number {
    const migration = migrations.find(item => item.oldId == labelId)
    return migration != null ? migration.newId : labelId
  }

  private static remapLabelIdList(labelIdList: string, migrations: LabelIdMigration[]): string {
    if (labelIdList.length === 0 || migrations.length === 0) return labelIdList

    const nextIds: number[] = []
    labelIdList
      .split(',')
      .map(id => parseInt(id))
      .filter(id => !Number.isNaN(id))
      .forEach(id => {
        const nextId = this.resolveMigratedLabelId(id, migrations)
        if (nextIds.includes(nextId) == false) {
          nextIds.push(nextId)
        }
      })

    return nextIds.join(',')
  }

  private static remapAccountLabelReferences(migrations: LabelIdMigration[]): boolean {
    if (migrations.length === 0) return true

    const entries = StorageUtils.getAccountEntries()
    const updatedEntries = entries.map((entry): AccountEntry => ({
      ...entry,
      labelIdList: this.remapLabelIdList(entry.labelIdList, migrations),
      updateTime: Date.now()
    }))
    if (!StorageUtils.saveAccountEntries(updatedEntries)) return false

    const renewals = StorageUtils.getAutoRenewals()
    const updatedRenewals = renewals.map((renewal): AutoRenewal => ({
      ...renewal,
      labelIdList: this.remapLabelIdList(renewal.labelIdList, migrations),
      updateTime: Date.now()
    }))
    if (!StorageUtils.saveAutoRenewals(updatedRenewals)) return false

    const settings = StorageUtils.getBudgetSettings()
    const nextBudgets: LabelBudgetSetting[] = []
    settings.labelMonthlyBudgets.forEach(item => {
      const nextLabelId = this.resolveMigratedLabelId(item.labelId, migrations)
      const existing = nextBudgets.find(budget => budget.labelId == nextLabelId)
      if (existing == null) {
        nextBudgets.push({
          labelId: nextLabelId,
          amount: item.amount
        })
      } else {
        existing.amount = item.amount
      }
    })

    return StorageUtils.saveBudgetSettings({
      ...settings,
      labelMonthlyBudgets: nextBudgets,
      updateTime: Date.now()
    })
  }

  private static normalizeReferenceLabelIdList(labelIdList: string, validLabelIds: number[]): string {
    if (labelIdList.length === 0) return ''

    const nextIds: number[] = []
    labelIdList
      .split(',')
      .map(id => parseInt(id))
      .filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
      .forEach(id => {
        if (nextIds.includes(id) == false) {
          nextIds.push(id)
        }
      })

    return nextIds.join(',')
  }

  private static sanitizeAllLabelReferences(): boolean {
    const eventLabelIds = StorageUtils.getEventLabels().map(label => label.id)
    const accountLabelIds = StorageUtils.getAccountLabels().map(label => label.id)
    let success = true

    const events = StorageUtils.getEvents()
    let eventsChanged = false
    const nextEvents = events.map((event): Event => {
      const nextLabelIdList = this.normalizeReferenceLabelIdList(event.labelIdList, eventLabelIds)
      if (nextLabelIdList == event.labelIdList) return event
      eventsChanged = true
      return {
        ...event,
        labelIdList: nextLabelIdList,
        updateTime: Date.now()
      }
    })
    if (eventsChanged) {
      success = StorageUtils.saveEvents(nextEvents) && success
    }

    const entries = StorageUtils.getAccountEntries()
    let entriesChanged = false
    const nextEntries = entries.map((entry): AccountEntry => {
      const nextLabelIdList = this.normalizeReferenceLabelIdList(entry.labelIdList, accountLabelIds)
      if (nextLabelIdList == entry.labelIdList) return entry
      entriesChanged = true
      return {
        ...entry,
        labelIdList: nextLabelIdList,
        updateTime: Date.now()
      }
    })
    if (entriesChanged) {
      success = StorageUtils.saveAccountEntries(nextEntries) && success
    }

    const renewals = StorageUtils.getAutoRenewals()
    let renewalsChanged = false
    const nextRenewals = renewals.map((renewal): AutoRenewal => {
      const nextLabelIdList = this.normalizeReferenceLabelIdList(renewal.labelIdList, accountLabelIds)
      if (nextLabelIdList == renewal.labelIdList) return renewal
      renewalsChanged = true
      return {
        ...renewal,
        labelIdList: nextLabelIdList,
        updateTime: Date.now()
      }
    })
    if (renewalsChanged) {
      success = StorageUtils.saveAutoRenewals(nextRenewals) && success
    }

    const settings = StorageUtils.getBudgetSettings()
    const nextBudgets = settings.labelMonthlyBudgets.filter(item => accountLabelIds.includes(item.labelId))
    if (nextBudgets.length != settings.labelMonthlyBudgets.length) {
      success = StorageUtils.saveBudgetSettings({
        ...settings,
        labelMonthlyBudgets: nextBudgets,
        updateTime: Date.now()
      }) && success
    }

    return success
  }

  private static normalizeLabels(kind: LabelKind): void {
    const labels = this.getLabelsByKind(kind)
    if (labels.length === 0) {
      return
    }

    const usedIds: number[] = []
    const usedNames: string[] = []
    const normalized: Label[] = []
    const migrations: LabelIdMigration[] = []
    let nextId = this.getInitialNextLabelId(kind, labels)
    let changed = false

    labels
      .slice()
      .sort((a, b) => a.sortOrder - b.sortOrder)
      .forEach(label => {
        const normalizedName = label.name.trim()
        if (normalizedName.length === 0) {
          changed = true
          return
        }

        if (usedNames.includes(normalizedName)) {
          changed = true
          return
        }

        let nextLabelId = label.id
        if (usedIds.includes(nextLabelId) || nextLabelId <= 0 || (kind == 'account' && nextLabelId <= this.accountLabelIdBase)) {
          nextLabelId = nextId++
          changed = true
        }
        if (nextLabelId != label.id) {
          migrations.push({
            oldId: label.id,
            newId: nextLabelId
          })
        }

        usedIds.push(nextLabelId)
        usedNames.push(normalizedName)
        normalized.push({
          ...label,
          id: nextLabelId,
          name: normalizedName,
          sortOrder: normalized.length + 1
        })
      })

    if (changed) {
      const saveSuccess = this.saveLabelsByKind(kind, normalized)
      if (saveSuccess && kind == 'account') {
        this.remapAccountLabelReferences(migrations)
      }
    }
  }
}
