// #ifdef APP-ANDROID
import {
	saveWidgetSnapshot as androidSaveWidgetSnapshot,
	consumePendingWidgetAction as androidConsumePendingWidgetAction,
	refreshWidget as androidRefreshWidget,
	requestEventNotificationPermission as androidRequestEventNotificationPermission,
	scheduleEventNotifications as androidScheduleEventNotifications,
	cancelEventNotifications as androidCancelEventNotifications
} from './app-android/index.uts'
// #endif

export function saveWidgetSnapshot(payload: string): void {
	// #ifdef APP-ANDROID
	androidSaveWidgetSnapshot(payload)
	// #endif
}

export function consumePendingWidgetAction(): string {
	// #ifdef APP-ANDROID
	return androidConsumePendingWidgetAction()
	// #endif
	return ''
}

export function refreshWidget(): void {
	// #ifdef APP-ANDROID
	androidRefreshWidget()
	// #endif
}

export function requestEventNotificationPermission(): void {
	// #ifdef APP-ANDROID
	androidRequestEventNotificationPermission()
	// #endif
}

export function scheduleEventNotifications(payload: string): void {
	// #ifdef APP-ANDROID
	androidScheduleEventNotifications(payload)
	// #endif
}

export function cancelEventNotifications(): void {
	// #ifdef APP-ANDROID
	androidCancelEventNotifications()
	// #endif
}
