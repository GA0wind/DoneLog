<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<view class="section-card compact-section-card">
			<view class="section-header compact-section-header">
				<view class="section-heading">
					<text class="section-title">记账标签</text>
					<text class="section-desc">维护分类标签、颜色和排序。</text>
				</view>
				<button class="link-btn" @click="goToLabels">标签管理</button>
			</view>
		</view>

		<view class="section-card">
			<view class="section-header">
				<view class="section-heading">
					<text class="section-title">支付方式</text>
					<text class="section-desc">新增常用支付方式，并指定新增账单默认选中的方式。</text>
				</view>
				<button class="link-btn" @click="openPaymentMethodModal(null)">新增</button>
			</view>
			<view class="manage-list">
				<view class="manage-row" v-for="method in paymentMethods" :key="method.id">
					<view class="manage-main" @click="openPaymentMethodModal(method)">
						<text class="manage-name">{{method.name}}</text>
						<text class="manage-meta">{{method.isDefault ? '默认支付方式' : '可用于记账和自动续费'}}</text>
					</view>
					<view class="manage-actions">
						<view class="mini-action primary" v-if="method.isDefault == false" @click.stop="setDefaultPaymentMethod(method.id)"><text class="mini-action-text primary">默认</text></view>
						<view class="mini-action" @click.stop="openPaymentMethodModal(method)"><text class="mini-action-text">改</text></view>
						<view class="mini-action danger" @click.stop="openDeletePaymentMethodDialog(method)"><text class="mini-action-text danger">删</text></view>
					</view>
				</view>
			</view>
		</view>

		<view class="section-card">
			<view class="section-header">
				<view class="section-heading">
					<text class="section-title">本月预算</text>
					<text class="section-desc">{{monthlyBudget > 0 ? budgetStatusText : '设置后会自动跟踪本月支出。'}}</text>
				</view>
				<button class="link-btn" @click="openBudgetModal">{{monthlyBudget > 0 ? '调整' : '设置'}}</button>
			</view>
			<view v-if="monthlyBudget > 0">
				<view class="budget-numbers">
					<text class="budget-used">已用 ¥{{monthOverview.expense.toFixed(2)}}</text>
					<text class="budget-total">预算 ¥{{monthlyBudget.toFixed(2)}}</text>
				</view>
				<view class="budget-bar">
					<view class="budget-progress" :class="{ over: budgetRemaining < 0 }" :style="{ width: budgetUsedPercent + '%' }"></view>
				</view>
			</view>
		</view>

		<view class="section-card">
			<view class="section-header">
				<view class="section-heading">
					<text class="section-title">标签预算</text>
					<text class="section-desc">按餐饮、交通等记账标签拆分本月支出预算。</text>
				</view>
				<button class="link-btn" @click="openLabelBudgetModal(0)">设置</button>
			</view>
			<view v-if="visibleLabelBudgetOverviews.length > 0">
				<view class="budget-item" v-for="item in visibleLabelBudgetOverviews" :key="item.labelId" @click="openLabelBudgetModal(item.labelId)">
					<view class="budget-item-top">
						<view class="budget-label">
							<view class="label-dot" :style="{ backgroundColor: getLabelColor(item.labelId) }"></view>
							<text class="budget-name">{{getLabelName(item.labelId)}}</text>
						</view>
						<text class="budget-status" :class="{ over: item.isOverBudget }">{{getLabelBudgetStatus(item)}}</text>
					</view>
					<view class="budget-bar slim">
						<view class="budget-progress slim-progress" :class="{ over: item.isOverBudget }" :style="{ width: item.usedPercent + '%' }"></view>
					</view>
					<view class="budget-meta">
						<text class="budget-meta-text">已用 ¥{{item.usedAmount.toFixed(2)}}</text>
						<text class="budget-meta-text">预算 ¥{{item.monthlyBudget.toFixed(2)}}</text>
					</view>
				</view>
			</view>
			<view class="empty-card" v-else>
				<text>还没有设置标签预算</text>
			</view>
		</view>

		<view class="section-card">
			<view class="section-header">
				<view class="section-heading">
					<text class="section-title">自动续费</text>
					<text class="section-desc">每月指定日期自动生成支出账单。</text>
				</view>
				<button class="link-btn" @click="openRenewalModal(null)">新增</button>
			</view>
			<view class="manage-list" v-if="autoRenewals.length > 0">
				<view class="manage-row" v-for="renewal in autoRenewals" :key="renewal.id">
					<view class="manage-main" @click="openRenewalModal(renewal)">
						<text class="manage-name">{{renewal.name}}</text>
						<text class="manage-meta">下次 {{formatDate(renewal.nextChargeDate)}} · {{getPaymentMethodName(renewal.paymentMethodId)}}</text>
					</view>
					<view class="manage-actions">
						<text class="renewal-amount">¥{{renewal.amount.toFixed(2)}}</text>
						<view class="mini-action primary" :class="{ muted: renewal.isEnabled == false }" @click.stop="toggleRenewal(renewal)">
							<text class="mini-action-text primary">{{renewal.isEnabled ? '启用' : '停用'}}</text>
						</view>
						<view class="mini-action danger" @click.stop="openDeleteRenewalDialog(renewal)"><text class="mini-action-text danger">删</text></view>
					</view>
				</view>
			</view>
			<view class="empty-card" v-else>
				<text>还没有自动续费项目</text>
			</view>
		</view>

		<view class="modal" v-if="showPaymentMethodModal" @click="hidePaymentMethodModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">{{editingPaymentMethodId > 0 ? '编辑支付方式' : '新增支付方式'}}</text>
				<view class="form-item">
					<text class="form-label">名称</text>
					<input class="input" v-model="paymentMethodName" placeholder="例如：现金、信用卡" confirm-type="done" @confirm="savePaymentMethod" />
				</view>
				<text class="error-tip" v-if="paymentMethodError">{{paymentMethodError}}</text>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hidePaymentMethodModal">取消</button>
					<button class="confirm-btn" @click.stop="savePaymentMethod">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showDeletePaymentMethodModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">删除支付方式</text>
				<text class="modal-desc">删除「{{pendingDeletePaymentMethodName}}」后，相关账单和自动续费会改用默认支付方式。</text>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideDeletePaymentMethodDialog">取消</button>
					<button class="confirm-btn danger-confirm-btn" @click.stop="confirmDeletePaymentMethod">确认删除</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showBudgetModal" @click="hideBudgetModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">设置月预算</text>
				<view class="form-item">
					<text class="form-label">每月支出预算</text>
					<input class="input" type="digit" v-model="budgetAmount" placeholder="例如：3000" confirm-type="done" @input="clearBudgetError" @confirm="saveBudget" />
					<text class="error-tip" v-if="budgetError">{{budgetError}}</text>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="clearBudget">清空</button>
					<button class="confirm-btn" @click.stop="saveBudget">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showLabelBudgetModal && !showBudgetLabelSelector" @click="hideLabelBudgetModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">设置标签预算</text>
				<view class="form-item">
					<text class="form-label">预算标签</text>
					<view class="picker" @click="showBudgetLabelSelector = true"><text>{{selectedBudgetLabelName}}</text></view>
				</view>
				<view class="form-item">
					<text class="form-label">每月支出预算</text>
					<input class="input" type="digit" v-model="labelBudgetAmount" placeholder="例如：800" confirm-type="done" @input="clearLabelBudgetError" @confirm="saveLabelBudget" />
					<text class="error-tip" v-if="labelBudgetError">{{labelBudgetError}}</text>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="clearLabelBudget">清空</button>
					<button class="confirm-btn" @click.stop="saveLabelBudget">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showBudgetLabelSelector" @click="showBudgetLabelSelector = false">
			<view class="modal-content" @click.stop>
				<text class="modal-title">选择预算标签</text>
				<scroll-view direction="vertical" class="selector-body">
					<view class="selector-item" :class="{ selected: selectedBudgetLabelId === label.id }" v-for="label in labels" :key="label.id" @click="selectBudgetLabel(label.id)">
						<text class="selector-name">{{label.name}}</text>
						<text class="selector-check" :class="{ visible: selectedBudgetLabelId === label.id }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer"><button class="cancel-btn single-cancel-btn" @click="showBudgetLabelSelector = false">取消</button></view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalModal && !showRenewalLabelSelector && !showRenewalPaymentSelector && !showRenewalDateSelector" @click="hideRenewalModal">
			<view class="modal-content tall-modal-content" @click.stop>
				<text class="modal-title">{{editingRenewalId > 0 ? '编辑自动续费' : '新增自动续费'}}</text>
				<scroll-view direction="vertical" class="form-body">
					<view class="form-item">
						<text class="form-label">名称</text>
						<input class="input" v-model="renewalName" placeholder="例如：视频会员、云存储" />
					</view>
					<view class="form-item">
						<text class="form-label">扣款金额</text>
						<input class="input" type="digit" v-model="renewalAmount" placeholder="请输入金额" />
					</view>
					<view class="form-item">
						<text class="form-label">支付方式</text>
						<view class="picker" @click="showRenewalPaymentSelector = true"><text>{{selectedRenewalPaymentMethodName}}</text></view>
					</view>
					<view class="form-item">
						<text class="form-label">下次扣款日期</text>
						<view class="picker" @click="openRenewalDateSelector"><text>{{renewalDate}}</text></view>
					</view>
					<view class="form-item">
						<text class="form-label">标签</text>
						<view class="tag-selector" @click="showRenewalLabelSelector = true">
							<view class="selected-tags">
								<text class="tag" v-for="labelId in renewalLabelIds" :key="labelId" :style="{ backgroundColor: getLabelColor(labelId) }">
									{{getLabelName(labelId)}}
								</text>
								<text class="placeholder" v-if="renewalLabelIds.length === 0">请选择标签</text>
							</view>
						</view>
					</view>
					<view class="form-item last-form-item">
						<text class="form-label">备注</text>
						<textarea class="textarea" v-model="renewalRemark" placeholder="可选" />
					</view>
				</scroll-view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideRenewalModal">取消</button>
					<button class="confirm-btn" @click.stop="saveRenewal">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalPaymentSelector" @click="showRenewalPaymentSelector = false">
			<view class="modal-content" @click.stop>
				<text class="modal-title">选择支付方式</text>
				<scroll-view direction="vertical" class="selector-body payment-selector-body">
					<view class="selector-item" :class="{ selected: renewalPaymentMethodId === method.id }" v-for="method in paymentMethods" :key="method.id" @click="selectRenewalPaymentMethod(method.id)">
						<text class="selector-name">{{method.name}}</text>
						<text class="selector-check" :class="{ visible: renewalPaymentMethodId === method.id }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer"><button class="cancel-btn single-cancel-btn" @click="showRenewalPaymentSelector = false">取消</button></view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalDateSelector" @click="showRenewalDateSelector = false">
			<view class="modal-content date-modal-content" @click.stop>
				<text class="modal-title">选择下次扣款日期</text>
				<view class="date-calendar-header">
					<view class="date-nav-btn" @click="changeRenewalDatePickerMonth(-1)"><text class="date-nav-text">‹</text></view>
					<text class="date-calendar-title">{{selectedDateYear}} 年 {{selectedDateMonth}} 月</text>
					<view class="date-nav-btn" @click="changeRenewalDatePickerMonth(1)"><text class="date-nav-text">›</text></view>
				</view>
				<view class="date-week-row"><text class="date-week-text" v-for="item in dateWeekdays" :key="item">{{item}}</text></view>
				<view class="date-grid">
					<view class="date-day" v-for="(item, index) in datePickerDays" :key="index" :class="{ selected: isSelectedDatePickerDay(item) }" @click="selectDatePickerDay(item)">
						<text class="date-day-text" :class="{ selected: isSelectedDatePickerDay(item), muted: !item.isCurrentMonth }">{{item.day}}</text>
					</view>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click="showRenewalDateSelector = false">取消</button>
					<button class="confirm-btn" @click="confirmRenewalDateSelector">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalLabelSelector" @click="showRenewalLabelSelector = false">
			<view class="modal-content" @click.stop>
				<text class="modal-title">选择自动续费标签</text>
				<scroll-view direction="vertical" class="selector-body">
					<view class="selector-item" :class="{ selected: renewalLabelIds.includes(label.id) }" v-for="label in labels" :key="label.id" @click="toggleRenewalLabel(label.id)">
						<view class="selector-left">
							<view class="label-dot" :style="{ backgroundColor: label.color }"></view>
							<text class="selector-name">{{label.name}}</text>
						</view>
						<text class="selector-check" :class="{ visible: renewalLabelIds.includes(label.id) }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer">
					<button class="confirm-btn single-confirm-btn" @click.stop="showRenewalLabelSelector = false">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showDeleteRenewalModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">删除自动续费</text>
				<text class="modal-desc">确定删除「{{pendingDeleteRenewalName}}」吗？已生成的账单不会删除。</text>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideDeleteRenewalDialog">取消</button>
					<button class="confirm-btn danger-confirm-btn" @click.stop="confirmDeleteRenewal">确认删除</button>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { AccountManager, AccountOverview, LabelBudgetOverview } from '@/utils/accountManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { AutoRenewal, Label, PaymentMethod } from '@/utils/storage.uts'

	type AccountSettingsDatePickerDay = {
		year: number
		month: number
		day: number
		isCurrentMonth: boolean
	}

	const labels = ref<Label[]>([])
	const paymentMethods = ref<PaymentMethod[]>([])
	const autoRenewals = ref<AutoRenewal[]>([])
	const monthOverview = ref<AccountOverview>({ income: 0, expense: 0, count: 0 })
	const monthlyBudget = ref(0)
	const labelBudgetOverviews = ref<LabelBudgetOverview[]>([])

	const showPaymentMethodModal = ref(false)
	const showDeletePaymentMethodModal = ref(false)
	const showBudgetModal = ref(false)
	const showLabelBudgetModal = ref(false)
	const showBudgetLabelSelector = ref(false)
	const showRenewalModal = ref(false)
	const showRenewalLabelSelector = ref(false)
	const showRenewalPaymentSelector = ref(false)
	const showRenewalDateSelector = ref(false)
	const showDeleteRenewalModal = ref(false)

	const editingPaymentMethodId = ref(0)
	const paymentMethodName = ref('')
	const paymentMethodError = ref('')
	const pendingDeletePaymentMethodId = ref(0)
	const pendingDeletePaymentMethodName = ref('')

	const budgetAmount = ref('')
	const budgetError = ref('')
	const selectedBudgetLabelId = ref(0)
	const labelBudgetAmount = ref('')
	const labelBudgetError = ref('')

	const editingRenewalId = ref(0)
	const renewalName = ref('')
	const renewalAmount = ref('')
	const renewalPaymentMethodId = ref(1)
	const renewalDate = ref('')
	const selectedDateYear = ref(new Date().getFullYear())
	const selectedDateMonth = ref(new Date().getMonth() + 1)
	const selectedDateDay = ref(new Date().getDate())
	const dateWeekdays = ['日', '一', '二', '三', '四', '五', '六']
	const renewalLabelIds = ref<number[]>([])
	const renewalRemark = ref('')
	const pendingDeleteRenewalId = ref(0)
	const pendingDeleteRenewalName = ref('')

	const formatDate = (timestamp: number): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')
		return `${year}-${month}-${day}`
	}

	const createDatePickerDays = (year: number, month: number): AccountSettingsDatePickerDay[] => {
		const days: AccountSettingsDatePickerDay[] = []
		const firstWeekday = new Date(year, month - 1, 1).getDay()
		const prevMonthLastDay = new Date(year, month - 1, 0).getDate()
		const currentMonthLastDay = new Date(year, month, 0).getDate()
		for (let i = firstWeekday - 1; i >= 0; i--) {
			const date = new Date(year, month - 2, prevMonthLastDay - i)
			days.push({ year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate(), isCurrentMonth: false })
		}
		for (let day = 1; day <= currentMonthLastDay; day++) {
			days.push({ year, month, day, isCurrentMonth: true })
		}
		for (let day = 1; days.length < 42; day++) {
			const date = new Date(year, month, day)
			days.push({ year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate(), isCurrentMonth: false })
		}
		return days
	}

	const datePickerDays = computed(() => createDatePickerDays(selectedDateYear.value, selectedDateMonth.value))
	const isSelectedDatePickerDay = (item: AccountSettingsDatePickerDay): boolean => {
		return item.year === selectedDateYear.value && item.month === selectedDateMonth.value && item.day === selectedDateDay.value
	}
	const selectDatePickerDay = (item: AccountSettingsDatePickerDay) => {
		selectedDateYear.value = item.year
		selectedDateMonth.value = item.month
		selectedDateDay.value = item.day
	}
	const changeRenewalDatePickerMonth = (offset: number) => {
		const date = new Date(selectedDateYear.value, selectedDateMonth.value - 1 + offset, 1)
		selectedDateYear.value = date.getFullYear()
		selectedDateMonth.value = date.getMonth() + 1
		selectedDateDay.value = Math.min(selectedDateDay.value, new Date(selectedDateYear.value, selectedDateMonth.value, 0).getDate())
	}
	const openRenewalDateSelector = () => {
		const parts = renewalDate.value.split('-')
		if (parts.length === 3) {
			selectedDateYear.value = parseInt(parts[0])
			selectedDateMonth.value = parseInt(parts[1])
			selectedDateDay.value = parseInt(parts[2])
		}
		showRenewalDateSelector.value = true
	}
	const confirmRenewalDateSelector = () => {
		renewalDate.value = `${selectedDateYear.value}-${`${selectedDateMonth.value}`.padStart(2, '0')}-${`${selectedDateDay.value}`.padStart(2, '0')}`
		showRenewalDateSelector.value = false
	}
	const selectRenewalPaymentMethod = (methodId: number) => {
		renewalPaymentMethodId.value = methodId
		showRenewalPaymentSelector.value = false
	}

	const parseLabelIds = (labelIdList: string): number[] => {
		if (labelIdList.length === 0) return []
		const validLabelIds = labels.value.map(label => label.id)
		return labelIdList
			.split(',')
			.map(id => parseInt(id))
			.filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
	}

	const loadData = () => {
		LabelManager.repairLabelData()
		AccountManager.processDueAutoRenewals()
		labels.value = LabelManager.getSortedLabels('account')
		paymentMethods.value = AccountManager.getPaymentMethods()
		autoRenewals.value = AccountManager.getAutoRenewals()
		monthOverview.value = AccountManager.getOverview('month')
		monthlyBudget.value = AccountManager.getBudgetSettings().monthlyExpenseBudget
		labelBudgetOverviews.value = AccountManager.getMonthlyLabelBudgetOverviews()
	}

	const budgetRemaining = computed(() => monthlyBudget.value - monthOverview.value.expense)
	const budgetUsedPercent = computed(() => {
		if (monthlyBudget.value <= 0) return 0
		return Math.min(100, Math.round(monthOverview.value.expense / monthlyBudget.value * 100))
	})
	const budgetStatusText = computed(() => {
		if (monthlyBudget.value <= 0) return ''
		if (budgetRemaining.value < 0) return `本月预算已超出 ¥${Math.abs(budgetRemaining.value).toFixed(2)}`
		return `本月预算剩余 ¥${budgetRemaining.value.toFixed(2)}`
	})
	const visibleLabelBudgetOverviews = computed<LabelBudgetOverview[]>(() => {
		return labelBudgetOverviews.value.filter(item => item.monthlyBudget > 0)
	})
	const selectedBudgetLabelName = computed(() => {
		if (labels.value.length === 0) return '暂无标签'
		const label = labels.value.find(item => item.id === selectedBudgetLabelId.value)
		return label != null ? label.name : labels.value[0].name
	})
	const selectedRenewalPaymentMethodName = computed(() => {
		const method = paymentMethods.value.find(item => item.id === renewalPaymentMethodId.value)
		if (method != null) return method.name
		return paymentMethods.value.length > 0 ? paymentMethods.value[0].name : '未设置'
	})

	const getLabelName = (labelId: number): string => {
		const label = labels.value.find(item => item.id === labelId)
		return label != null ? label.name : '未知标签'
	}

	const getLabelColor = (labelId: number): string => {
		const label = labels.value.find(item => item.id === labelId)
		return label != null ? label.color : '#B7A995'
	}

	const getLabelBudgetStatus = (item: LabelBudgetOverview): string => {
		if (item.isOverBudget) return `超出 ¥${Math.abs(item.remainingAmount).toFixed(2)}`
		return `剩余 ¥${item.remainingAmount.toFixed(2)}`
	}

	const getPaymentMethodName = (paymentMethodId: number): string => {
		return AccountManager.getPaymentMethodName(paymentMethodId)
	}

	const goToLabels = () => {
		uni.setStorageSync('donelog_label_manage_kind', 'account')
		uni.navigateTo({
			url: '/pages/my/labels?kind=account'
		})
	}

	const openPaymentMethodModal = (method: PaymentMethod | null) => {
		paymentMethodError.value = ''
		if (method == null) {
			editingPaymentMethodId.value = 0
			paymentMethodName.value = ''
		} else {
			editingPaymentMethodId.value = method.id
			paymentMethodName.value = method.name
		}
		showPaymentMethodModal.value = true
	}

	const hidePaymentMethodModal = () => {
		showPaymentMethodModal.value = false
		paymentMethodError.value = ''
	}

	const savePaymentMethod = () => {
		const name = paymentMethodName.value.trim()
		if (name.length === 0) {
			paymentMethodError.value = '请输入支付方式名称'
			return
		}

		let success = false
		if (editingPaymentMethodId.value > 0) {
			const current = paymentMethods.value.find(method => method.id == editingPaymentMethodId.value)
			if (current == null) return
			success = AccountManager.updatePaymentMethod({ ...current, name })
		} else {
			success = AccountManager.addPaymentMethod({ name })
		}

		if (success == false) {
			paymentMethodError.value = '保存失败，可能已存在同名支付方式'
			return
		}
		hidePaymentMethodModal()
		loadData()
		uni.showToast({ title: '支付方式已保存', icon: 'success' })
	}

	const setDefaultPaymentMethod = (paymentMethodId: number) => {
		if (AccountManager.setDefaultPaymentMethod(paymentMethodId)) {
			loadData()
			uni.showToast({ title: '已设为默认', icon: 'success' })
		}
	}

	const openDeletePaymentMethodDialog = (method: PaymentMethod) => {
		if (paymentMethods.value.length <= 1) {
			uni.showToast({ title: '至少保留一种支付方式', icon: 'none' })
			return
		}
		pendingDeletePaymentMethodId.value = method.id
		pendingDeletePaymentMethodName.value = method.name
		showDeletePaymentMethodModal.value = true
	}

	const hideDeletePaymentMethodDialog = () => {
		showDeletePaymentMethodModal.value = false
		pendingDeletePaymentMethodId.value = 0
		pendingDeletePaymentMethodName.value = ''
	}

	const confirmDeletePaymentMethod = () => {
		const paymentMethodId = pendingDeletePaymentMethodId.value
		if (paymentMethodId <= 0) return
		const success = AccountManager.deletePaymentMethod(paymentMethodId)
		const deleted = AccountManager.getPaymentMethods().find(method => method.id == paymentMethodId) == null
		if (success == false || deleted == false) {
			uni.showToast({ title: '删除失败', icon: 'none' })
			return
		}
		hideDeletePaymentMethodDialog()
		loadData()
		uni.showToast({ title: '删除成功', icon: 'success' })
	}

	const openBudgetModal = () => {
		budgetAmount.value = monthlyBudget.value > 0 ? `${monthlyBudget.value}` : ''
		budgetError.value = ''
		showBudgetModal.value = true
	}

	const hideBudgetModal = () => {
		showBudgetModal.value = false
		budgetError.value = ''
	}

	const clearBudgetError = () => {
		if (budgetError.value.length > 0) budgetError.value = ''
	}

	const saveBudget = () => {
		const amount = parseFloat(budgetAmount.value)
		if (Number.isNaN(amount) || amount <= 0) {
			budgetError.value = '请输入大于 0 的预算金额'
			return
		}
		if (AccountManager.saveMonthlyExpenseBudget(amount)) {
			hideBudgetModal()
			loadData()
			uni.showToast({ title: '预算已保存', icon: 'success' })
		} else {
			budgetError.value = '保存失败，请稍后再试'
		}
	}

	const clearBudget = () => {
		if (AccountManager.saveMonthlyExpenseBudget(0)) {
			hideBudgetModal()
			loadData()
			uni.showToast({ title: '预算已清空', icon: 'success' })
		} else {
			budgetError.value = '清空失败，请稍后再试'
		}
	}

	const openLabelBudgetModal = (labelId: number) => {
		if (labels.value.length === 0) {
			uni.showToast({ title: '请先创建记账标签', icon: 'none' })
			return
		}
		selectedBudgetLabelId.value = labelId > 0 ? labelId : labels.value[0].id
		labelBudgetAmount.value = `${AccountManager.getLabelBudgetAmount(selectedBudgetLabelId.value)}`
		if (labelBudgetAmount.value === '0') {
			labelBudgetAmount.value = ''
		}
		labelBudgetError.value = ''
		showBudgetLabelSelector.value = false
		showLabelBudgetModal.value = true
	}

	const hideLabelBudgetModal = () => {
		showLabelBudgetModal.value = false
		showBudgetLabelSelector.value = false
		labelBudgetError.value = ''
	}

	const clearLabelBudgetError = () => {
		if (labelBudgetError.value.length > 0) labelBudgetError.value = ''
	}

	const selectBudgetLabel = (labelId: number) => {
		selectedBudgetLabelId.value = labelId
		const amount = AccountManager.getLabelBudgetAmount(selectedBudgetLabelId.value)
		labelBudgetAmount.value = amount > 0 ? `${amount}` : ''
		showBudgetLabelSelector.value = false
	}

	const saveLabelBudget = () => {
		if (selectedBudgetLabelId.value <= 0) {
			labelBudgetError.value = '请选择标签'
			return
		}
		const amount = parseFloat(labelBudgetAmount.value)
		if (Number.isNaN(amount) || amount <= 0) {
			labelBudgetError.value = '请输入大于 0 的预算金额'
			return
		}
		if (AccountManager.saveLabelMonthlyBudget(selectedBudgetLabelId.value, amount)) {
			hideLabelBudgetModal()
			loadData()
			uni.showToast({ title: '标签预算已保存', icon: 'success' })
		} else {
			labelBudgetError.value = '保存失败，请稍后再试'
		}
	}

	const clearLabelBudget = () => {
		if (selectedBudgetLabelId.value <= 0) {
			labelBudgetError.value = '请选择标签'
			return
		}
		if (AccountManager.saveLabelMonthlyBudget(selectedBudgetLabelId.value, 0)) {
			hideLabelBudgetModal()
			loadData()
			uni.showToast({ title: '标签预算已清空', icon: 'success' })
		} else {
			labelBudgetError.value = '清空失败，请稍后再试'
		}
	}

	const resetRenewalForm = () => {
		editingRenewalId.value = 0
		renewalName.value = ''
		renewalAmount.value = ''
		renewalPaymentMethodId.value = AccountManager.getDefaultPaymentMethodId()
		renewalDate.value = formatDate(Date.now())
		renewalLabelIds.value = []
		renewalRemark.value = ''
	}

	const openRenewalModal = (renewal: AutoRenewal | null) => {
		if (paymentMethods.value.length === 0) paymentMethods.value = AccountManager.getPaymentMethods()
		showRenewalLabelSelector.value = false
		showRenewalPaymentSelector.value = false
		showRenewalDateSelector.value = false
		if (renewal == null) {
			resetRenewalForm()
		} else {
			editingRenewalId.value = renewal.id
			renewalName.value = renewal.name
			renewalAmount.value = `${renewal.amount}`
			renewalPaymentMethodId.value = renewal.paymentMethodId
			renewalDate.value = formatDate(renewal.nextChargeDate)
			renewalLabelIds.value = parseLabelIds(renewal.labelIdList)
			renewalRemark.value = renewal.remark
		}
		showRenewalModal.value = true
	}

	const hideRenewalModal = () => {
		showRenewalModal.value = false
		showRenewalLabelSelector.value = false
		showRenewalPaymentSelector.value = false
		showRenewalDateSelector.value = false
	}

	const toggleRenewalLabel = (labelId: number) => {
		renewalLabelIds.value = renewalLabelIds.value.includes(labelId) ? [] : [labelId]
	}

	const saveRenewal = () => {
		const amount = parseFloat(renewalAmount.value)
		if (renewalName.value.trim().length === 0) {
			uni.showToast({ title: '请输入名称', icon: 'none' })
			return
		}
		if (Number.isNaN(amount) || amount <= 0) {
			uni.showToast({ title: '请输入正确金额', icon: 'none' })
			return
		}

		let success = false
		if (editingRenewalId.value > 0) {
			const current = autoRenewals.value.find(item => item.id === editingRenewalId.value)
			if (current == null) return
			success = AccountManager.updateAutoRenewal({
				...current,
				name: renewalName.value.trim(),
				amount,
				paymentMethodId: renewalPaymentMethodId.value,
				labelIdList: renewalLabelIds.value.join(','),
				nextChargeDate: new Date(renewalDate.value).getTime(),
				remark: renewalRemark.value.trim()
			})
		} else {
			success = AccountManager.addAutoRenewal({
				name: renewalName.value.trim(),
				amount,
				paymentMethodId: renewalPaymentMethodId.value,
				labelIdList: renewalLabelIds.value.join(','),
				nextChargeDate: new Date(renewalDate.value).getTime(),
				isEnabled: true,
				remark: renewalRemark.value.trim()
			})
		}

		if (success == true) {
			hideRenewalModal()
			loadData()
			uni.showToast({ title: '保存成功', icon: 'success' })
		}
	}

	const toggleRenewal = (renewal: AutoRenewal) => {
		AccountManager.updateAutoRenewal({
			...renewal,
			isEnabled: renewal.isEnabled == false
		})
		loadData()
	}

	const openDeleteRenewalDialog = (renewal: AutoRenewal) => {
		pendingDeleteRenewalId.value = renewal.id
		pendingDeleteRenewalName.value = renewal.name
		showDeleteRenewalModal.value = true
	}

	const hideDeleteRenewalDialog = () => {
		showDeleteRenewalModal.value = false
		pendingDeleteRenewalId.value = 0
		pendingDeleteRenewalName.value = ''
	}

	const confirmDeleteRenewal = () => {
		const renewalId = pendingDeleteRenewalId.value
		if (renewalId <= 0) return
		const success = AccountManager.deleteAutoRenewal(renewalId)
		const deleted = AccountManager.getAutoRenewals().find(renewal => renewal.id === renewalId) == null
		if (success == false || deleted == false) {
			uni.showToast({ title: '删除失败', icon: 'none' })
			return
		}
		hideDeleteRenewalDialog()
		loadData()
		uni.showToast({ title: '删除成功', icon: 'success' })
	}

	onShow(() => {
		loadData()
	})

	onLoad(() => {
		AccountManager.initIds()
		loadData()
	})
</script>

