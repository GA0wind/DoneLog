		lines: 1;
		text-overflow: ellipsis;
	}

	.renewal-meta {
		font-size: 12px;
		color: #7b8791;
		line-height: 1.4;
	}

	.renewal-right {
		flex-direction: row;
		align-items: center;
		flex-shrink: 0;
	}

	.renewal-amount {
		font-size: 14px;
