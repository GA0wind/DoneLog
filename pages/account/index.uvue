		border-color: #eadfd2;
		box-shadow: 0 12px 28px rgba(36, 50, 58, 0.05);
	}

	.renewal-card {
		padding: 16px;
		margin-bottom: 14px;
	}

	.settings-strip {
		flex-direction: row;
