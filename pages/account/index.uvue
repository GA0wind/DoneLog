	}

	.label-budget-top,
	.label-budget-meta,
	.label-budget-name-wrap {
		flex-direction: row;
		align-items: center;
	}

	.label-budget-top,
	.label-budget-meta {
		justify-content: space-between;
	}

	.label-budget-name-wrap {
		flex: 1;
		min-width: 0;
	}

	.label-budget-dot {
		width: 10px;
		height: 10px;
		border-radius: 5px;
		margin-right: 8px;
		flex-shrink: 0;
	}

	.label-budget-name {
		font-size: 13px;
		font-weight: 600;
		color: #24323a;
		flex: 1;
		lines: 1;
		text-overflow: ellipsis;
	}

	.label-budget-status {
		font-size: 12px;
		color: #1f7a72;
		margin-left: 8px;
	}

	.label-budget-status.over {
		color: #c45d42;
	}

	.budget-bar.slim {
		height: 6px;
		border-radius: 3px;
		margin: 8px 0;
	}

	.budget-progress.slim-progress {
		height: 6px;
		border-radius: 3px;
	}

	.label-budget-meta-text {
		font-size: 11px;
		color: #7b8791;
	}

	.list-card {
		overflow: hidden;
	}

	.entry-item {
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		padding: 16px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #f1e7dd;
	}

	.entry-left,
	.entry-right {
		flex-direction: row;
		align-items: center;
	}

	.entry-left {
		flex: 1;
		min-width: 0;
		padding-right: 10px;
	}

	.entry-right {
		margin-top: 8px;
		margin-left: auto;
	}

	.entry-info {
		margin-left: 10px;
		flex: 1;
		min-width: 0;
	}

	.entry-icon {
		width: 34px;
		height: 34px;
		border-radius: 17px;
		justify-content: center;
		align-items: center;
	}

	.entry-icon.expense {
		background-color: #f8ddd3;
	}

	.entry-icon.income {
		background-color: #e8f4f2;
	}

	.entry-icon-text {
		font-size: 12px;
		font-weight: bold;
