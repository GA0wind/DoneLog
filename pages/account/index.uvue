<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<view class="summary-card">
			<view class="summary-item" @click="goToExpenseChart">
				<text class="summary-value">¥{{monthOverview.expense.toFixed(2)}}</text>
				<text class="summary-label">本月支出 · 看分类</text>
			</view>
			<view class="summary-item" @click="goToIncomeChart">
				<text class="summary-value">¥{{monthOverview.income.toFixed(2)}}</text>
				<text class="summary-label">本月收入 · 看分类</text>
			</view>
			<view class="summary-item">
				<text class="summary-value">{{budgetRemainingText}}</text>
				<text class="summary-label">本月剩余预算</text>
			</view>
		</view>

		<view class="settings-strip" @click="goToSettings">
			<view>
				<text class="settings-title">记账设置</text>
				<text class="settings-desc">支付方式、预算、标签预算、自动续费</text>
			</view>
			<text class="settings-arrow">›</text>
		</view>

		<view class="list-card">
			<view class="entry-item" v-for="entry in entries" :key="entry.id" @click="editEntry(entry)">
				<view class="entry-left">
					<view class="entry-icon" :class="entry.type">
						<text class="entry-icon-text">{{entry.type === 'expense' ? '支' : '收'}}</text>
					</view>
					<view class="entry-info">
						<text class="entry-desc">{{getEntryDisplayDesc(entry)}}</text>
						<text class="entry-meta">{{getEntryLabelNames(entry)}} · {{getPaymentMethodName(entry.paymentMethodId)}} · {{formatDate(entry.occurredAt)}}</text>
					</view>
				</view>
				<view class="entry-right">
					<text class="entry-amount" :class="entry.type">{{entry.type === 'expense' ? '-' : '+'}}¥{{entry.amount.toFixed(2)}}</text>
					<button class="delete-btn" @click.stop="deleteEntry(entry.id)">删除</button>
				</view>
			</view>
			<view class="empty-tip" v-if="entries.length === 0">
				<text>还没有记账记录，点击右下角开始添加</text>
			</view>
		</view>

		<view class="add-btn" @click="openAddModal">
			<text class="add-icon">+</text>
		</view>

		<view class="modal" v-if="showModal && !showLabelSelector && !showAddLabelModal && !showPaymentSelector && !showDateSelector" @click="hideModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">{{editingId > 0 ? '编辑记账' : '新增记账'}}</text>
				<scroll-view direction="vertical" class="account-form-body">
					<view class="form-item">
						<text class="label">收支类型</text>
						<radio-group class="type-group" @change="onTypeChange">
							<label class="radio-chip first-radio-chip" :class="{ active: formType === 'expense' }">
								<radio value="expense" :checked="formType === 'expense'" color="#E07A5F" />
								<text>支出</text>
							</label>
							<label class="radio-chip" :class="{ active: formType === 'income' }">
								<radio value="income" :checked="formType === 'income'" color="#1F7A72" />
								<text>收入</text>
							</label>
						</radio-group>
					</view>

					<view class="form-item">
						<text class="label">金额</text>
						<input class="input" type="digit" v-model="formAmount" placeholder="请输入金额" />
					</view>

					<view class="form-item">
						<text class="label">标签</text>
						<view class="label-row">
							<view class="tag-selector" @click="showLabelSelector = true">
								<view class="selected-tags">
									<text class="tag" v-for="labelId in formLabelIds" :key="labelId" :style="{ backgroundColor: getLabelColor(labelId) }">
										{{getLabelName(labelId)}}
									</text>
									<text class="placeholder" v-if="formLabelIds.length === 0">请选择标签</text>
								</view>
							</view>
							<button class="mini-add-btn" @click.stop="openAddLabel">新增标签</button>
						</view>
					</view>

					<view class="form-item">
						<text class="label">支付方式</text>
						<view class="picker" @click="showPaymentSelector = true"><text>{{selectedPaymentMethodName}}</text></view>
					</view>

					<view class="form-item">
						<text class="label">记账日期</text>
						<view class="picker" @click="openDateSelector"><text>{{formDate}}</text></view>
					</view>

					<view class="form-item last-form-item">
						<text class="label">描述</text>
						<view class="textarea-shell">
							<textarea class="textarea entry-remark-textarea" v-model="formRemark" placeholder="例如：午餐、打车、工资、报销" />
						</view>
					</view>
				</scroll-view>

				<view class="modal-footer">
					<button class="cancel-btn" @click="hideModal">取消</button>
					<button class="confirm-btn" @click="saveEntry">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showPaymentSelector" @click="showPaymentSelector = false">
			<view class="modal-content selector-modal-content" @click.stop>
				<text class="modal-title">选择支付方式</text>
				<scroll-view direction="vertical" class="selector-body payment-selector-body">
					<view class="selector-item" :class="{ selected: formPaymentMethodId === method.id }" v-for="method in paymentMethods" :key="method.id" @click="selectPaymentMethod(method.id)">
						<text class="selector-name">{{method.name}}</text>
						<text class="selector-check" :class="{ visible: formPaymentMethodId === method.id }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer"><button class="cancel-btn single-cancel-btn" @click="showPaymentSelector = false">取消</button></view>
			</view>
		</view>

		<view class="modal" v-if="showDateSelector" @click="showDateSelector = false">
			<view class="modal-content date-modal-content" @click.stop>
				<text class="modal-title">选择记账日期</text>
				<view class="date-calendar-header">
					<view class="date-nav-btn" @click="changeDatePickerMonth(-1)"><text class="date-nav-text">‹</text></view>
					<text class="date-calendar-title">{{selectedDateYear}} 年 {{selectedDateMonth}} 月</text>
					<view class="date-nav-btn" @click="changeDatePickerMonth(1)"><text class="date-nav-text">›</text></view>
				</view>
				<view class="date-week-row"><text class="date-week-text" v-for="item in dateWeekdays" :key="item">{{item}}</text></view>
				<view class="date-grid">
					<view class="date-day" v-for="(item, index) in datePickerDays" :key="index" :class="{ selected: isSelectedDatePickerDay(item) }" @click="selectDatePickerDay(item)">
						<text class="date-day-text" :class="{ selected: isSelectedDatePickerDay(item), muted: !item.isCurrentMonth }">{{item.day}}</text>
					</view>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click="showDateSelector = false">取消</button>
					<button class="confirm-btn" @click="confirmDateSelector">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showAddLabelModal" @click="hideAddLabel">
			<view class="modal-content selector-modal-content" @click.stop>
				<text class="modal-title">新增记账标签</text>
				<view class="form-item">
					<text class="label">标签名称</text>
					<input class="input" v-model="newLabelName" placeholder="请输入标签名称" confirm-type="done" @input="clearNewLabelError" @confirm="addAccountLabel" />
					<text class="error-tip" v-if="newLabelError">{{newLabelError}}</text>
				</view>
				<view class="form-item">
					<text class="label">标签颜色</text>
					<view class="color-options">
						<view
							class="color-option"
							v-for="color in colorOptions"
							:key="color"
							:class="{ selected: newLabelColor === color }"
							:style="{ backgroundColor: color }"
							@click.stop="newLabelColor = color"
						>
							<text v-if="newLabelColor === color" class="color-check">✓</text>
						</view>
					</view>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideAddLabel">取消</button>
					<button class="confirm-btn" @click.stop="addAccountLabel">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showLabelSelector" @click="showLabelSelector = false">
			<view class="modal-content" @click.stop>
				<text class="modal-title">选择标签</text>
				<scroll-view direction="vertical" class="selector-body">
					<view class="selector-item" :class="{ selected: formLabelIds.includes(label.id) }" v-for="label in labels" :key="label.id" @click="toggleFormLabel(label.id)">
						<view class="selector-left">
							<view class="selector-color" :style="{ backgroundColor: label.color }"></view>
							<text class="selector-name">{{label.name}}</text>
						</view>
						<text class="selector-check" :class="{ visible: formLabelIds.includes(label.id) }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer">
					<button class="confirm-btn" @click="showLabelSelector = false">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalModal && !showRenewalLabelSelector" @click="hideRenewalModal">
			<view class="modal-content selector-modal-content" @click.stop>
				<text class="modal-title">{{editingRenewalId > 0 ? '编辑自动续费' : '新增自动续费'}}</text>
				<view class="form-item">
					<text class="label">名称</text>
					<input class="input" v-model="renewalName" placeholder="例如：视频会员、云存储" />
				</view>
				<view class="form-item">
					<text class="label">扣款金额</text>
					<input class="input" type="digit" v-model="renewalAmount" placeholder="请输入金额" />
				</view>
				<view class="form-item">
					<text class="label">支付方式</text>
					<picker mode="selector" :range="paymentMethodNames" :value="selectedRenewalPaymentMethodIndex" @change="onRenewalPaymentMethodChange">
						<view class="picker"><text>{{selectedRenewalPaymentMethodName}}</text></view>
					</picker>
				</view>
				<view class="form-item">
					<text class="label">下次扣款日期</text>
					<picker mode="date" :value="renewalDate" @change="onRenewalDateChange">
						<view class="picker"><text>{{renewalDate}}</text></view>
					</picker>
				</view>
				<view class="form-item">
					<text class="label">标签</text>
					<view class="tag-selector wide" @click="showRenewalLabelSelector = true">
						<view class="selected-tags">
							<text class="tag" v-for="labelId in renewalLabelIds" :key="labelId" :style="{ backgroundColor: getLabelColor(labelId) }">
								{{getLabelName(labelId)}}
							</text>
							<text class="placeholder" v-if="renewalLabelIds.length === 0">请选择标签</text>
						</view>
					</view>
				</view>
				<view class="form-item">
					<text class="label">备注</text>
					<textarea class="textarea small-textarea" v-model="renewalRemark" placeholder="可选" />
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideRenewalModal">取消</button>
					<button class="confirm-btn" @click.stop="saveRenewal">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showRenewalLabelSelector" @click="showRenewalLabelSelector = false">
			<view class="modal-content" @click.stop>
				<text class="modal-title">选择自动续费标签</text>
				<scroll-view direction="vertical" class="selector-body">
					<view class="selector-item" :class="{ selected: renewalLabelIds.includes(label.id) }" v-for="label in labels" :key="label.id" @click="toggleRenewalLabel(label.id)">
						<view class="selector-left">
							<view class="selector-color" :style="{ backgroundColor: label.color }"></view>
							<text class="selector-name">{{label.name}}</text>
						</view>
						<text class="selector-check" :class="{ visible: renewalLabelIds.includes(label.id) }">✓</text>
					</view>
				</scroll-view>
				<view class="modal-footer">
					<button class="confirm-btn" @click="showRenewalLabelSelector = false">确定</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showBudgetModal" @click="hideBudgetModal">
			<view class="modal-content selector-modal-content" @click.stop>
				<text class="modal-title">设置月预算</text>
				<view class="form-item">
					<text class="label">每月支出预算</text>
					<input class="input" type="digit" v-model="budgetAmount" placeholder="例如：3000" confirm-type="done" @input="clearBudgetError" @confirm="saveBudget" />
					<text class="error-tip" v-if="budgetError">{{budgetError}}</text>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="clearBudget">清空</button>
					<button class="confirm-btn" @click.stop="saveBudget">保存</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showLabelBudgetModal" @click="hideLabelBudgetModal">
			<view class="modal-content selector-modal-content" @click.stop>
				<text class="modal-title">设置标签预算</text>
				<view class="form-item">
					<text class="label">预算标签</text>
					<picker mode="selector" :range="labels" range-key="name" :value="selectedBudgetLabelIndex" @change="onLabelBudgetChange">
						<view class="picker"><text>{{selectedBudgetLabelName}}</text></view>
					</picker>
				</view>
				<view class="form-item">
					<text class="label">每月支出预算</text>
					<input class="input" type="digit" v-model="labelBudgetAmount" placeholder="例如：800" confirm-type="done" @input="clearLabelBudgetError" @confirm="saveLabelBudget" />
					<text class="error-tip" v-if="labelBudgetError">{{labelBudgetError}}</text>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="clearLabelBudget">清空</button>
					<button class="confirm-btn" @click.stop="saveLabelBudget">保存</button>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { AccountManager, LabelBudgetOverview, AccountOverview } from '@/utils/accountManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { AccountEntry, AccountEntryInput, AutoRenewal, Label, PaymentMethod } from '@/utils/storage.uts'

	type DatePickerDay = {
		year: number
		month: number
		day: number
		isCurrentMonth: boolean
	}

	const entries = ref<AccountEntry[]>([])
	const labels = ref<Label[]>([])
	const paymentMethods = ref<PaymentMethod[]>([])
	const autoRenewals = ref<AutoRenewal[]>([])
	const monthOverview = ref<AccountOverview>({ income: 0, expense: 0, count: 0 })
	const monthlyBudget = ref(0)
	const labelBudgetOverviews = ref<LabelBudgetOverview[]>([])

	const showModal = ref(false)
	const showPaymentSelector = ref(false)
	const showDateSelector = ref(false)
	const showAddLabelModal = ref(false)
	const showLabelSelector = ref(false)
	const showBudgetModal = ref(false)
	const showLabelBudgetModal = ref(false)
	const showRenewalModal = ref(false)
	const showRenewalLabelSelector = ref(false)
	const editingId = ref(0)
	const formType = ref<'expense' | 'income'>('expense')
	const formAmount = ref('')
	const formLabelIds = ref<number[]>([])
	const formPaymentMethodId = ref(1)
	const formDate = ref('')
	const selectedDateYear = ref(new Date().getFullYear())
	const selectedDateMonth = ref(new Date().getMonth() + 1)
	const selectedDateDay = ref(new Date().getDate())
	const dateWeekdays = ['日', '一', '二', '三', '四', '五', '六']
	const formRemark = ref('')
	const editingRenewalId = ref(0)
	const renewalName = ref('')
	const renewalAmount = ref('')
	const renewalPaymentMethodId = ref(1)
	const renewalDate = ref('')
	const renewalLabelIds = ref<number[]>([])
	const renewalRemark = ref('')
	const newLabelName = ref('')
	const newLabelError = ref('')
	const newLabelColor = ref('#1F7A72')
	const budgetAmount = ref('')
	const budgetError = ref('')
	const selectedBudgetLabelId = ref(0)
	const labelBudgetAmount = ref('')
	const labelBudgetError = ref('')
	const colorOptions = [
		'#1F7A72',
		'#2A9D8F',
		'#E07A5F',
		'#E9C46A',
		'#8AB17D',
		'#5D7FA3',
		'#B56576',
		'#6D597A'
	]

	const getDetailObject = (e: UTSJSONObject): UTSJSONObject | null => {
		const detail = e['detail']
		return detail != null ? detail as UTSJSONObject : null
	}

	const getDetailStringValue = (e: UTSJSONObject): string => {
		const detail = getDetailObject(e)
		if (detail == null) return ''
		const value = detail['value']
		return value != null ? `${value}` : ''
	}

	const getDetailNumberValue = (e: UTSJSONObject): number => {
		const value = getDetailStringValue(e)
		const parsed = parseInt(value)
		return Number.isNaN(parsed) ? 0 : parsed
	}

	const formatDate = (timestamp: number): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')
		return `${year}-${month}-${day}`
	}

	const createDatePickerDays = (year: number, month: number): DatePickerDay[] => {
		const days: DatePickerDay[] = []
		const firstWeekday = new Date(year, month - 1, 1).getDay()
		const prevMonthLastDay = new Date(year, month - 1, 0).getDate()
		const currentMonthLastDay = new Date(year, month, 0).getDate()
		for (let i = firstWeekday - 1; i >= 0; i--) {
			const date = new Date(year, month - 2, prevMonthLastDay - i)
			days.push({ year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate(), isCurrentMonth: false })
		}
		for (let day = 1; day <= currentMonthLastDay; day++) {
			days.push({ year, month, day, isCurrentMonth: true })
		}
		for (let day = 1; days.length < 42; day++) {
			const date = new Date(year, month, day)
			days.push({ year: date.getFullYear(), month: date.getMonth() + 1, day: date.getDate(), isCurrentMonth: false })
		}
		return days
	}

	const datePickerDays = computed(() => createDatePickerDays(selectedDateYear.value, selectedDateMonth.value))
	const isSelectedDatePickerDay = (item: DatePickerDay): boolean => {
		return item.year === selectedDateYear.value && item.month === selectedDateMonth.value && item.day === selectedDateDay.value
	}
	const selectDatePickerDay = (item: DatePickerDay) => {
		selectedDateYear.value = item.year
		selectedDateMonth.value = item.month
		selectedDateDay.value = item.day
	}
	const changeDatePickerMonth = (offset: number) => {
		const date = new Date(selectedDateYear.value, selectedDateMonth.value - 1 + offset, 1)
		selectedDateYear.value = date.getFullYear()
		selectedDateMonth.value = date.getMonth() + 1
		selectedDateDay.value = Math.min(selectedDateDay.value, new Date(selectedDateYear.value, selectedDateMonth.value, 0).getDate())
	}
	const openDateSelector = () => {
		const parts = formDate.value.split('-')
		if (parts.length === 3) {
			selectedDateYear.value = parseInt(parts[0])
			selectedDateMonth.value = parseInt(parts[1])
			selectedDateDay.value = parseInt(parts[2])
		}
		showDateSelector.value = true
	}
	const confirmDateSelector = () => {
		formDate.value = `${selectedDateYear.value}-${`${selectedDateMonth.value}`.padStart(2, '0')}-${`${selectedDateDay.value}`.padStart(2, '0')}`
		showDateSelector.value = false
	}
	const selectPaymentMethod = (methodId: number) => {
		formPaymentMethodId.value = methodId
		showPaymentSelector.value = false
	}

	const parseLabelIds = (labelIdList: string): number[] => {
		if (labelIdList.length === 0) return []
		const validLabelIds = labels.value.map(label => label.id)
		return labelIdList
			.split(',')
			.map(id => parseInt(id))
			.filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
	}

	const getLabelName = (labelId: number): string => {
		const label = labels.value.find(item => item.id === labelId)
		return label != null ? label.name : '未知标签'
	}

	const getLabelColor = (labelId: number): string => {
		const label = labels.value.find(item => item.id === labelId)
		return label != null ? label.color : '#B7A995'
	}

	const getLabelSortOrder = (labelId: number): number => {
		const label = labels.value.find(item => item.id === labelId)
		return label != null ? label.sortOrder : 9999
	}

	const getLabelBudgetStatus = (item: LabelBudgetOverview): string => {
		if (item.isOverBudget) return `超出 ¥${Math.abs(item.remainingAmount).toFixed(2)}`
		return `剩余 ¥${item.remainingAmount.toFixed(2)}`
	}

	const getEntryLabelNames = (entry: AccountEntry): string => {
		const names = parseLabelIds(entry.labelIdList).map(id => getLabelName(id)).filter(name => name.length > 0)
		return names.length > 0 ? names.join(' / ') : '未分类'
	}

	const getPaymentMethodName = (paymentMethodId: number): string => {
		return AccountManager.getPaymentMethodName(paymentMethodId)
	}

	const getEntryDisplayDesc = (entry: AccountEntry): string => {
		if (entry.remark.trim().length > 0) {
			return entry.remark
		}
		const names = parseLabelIds(entry.labelIdList).map(id => getLabelName(id)).filter(name => name.length > 0)
		return names.length > 0 ? names.join('，') : '无描述'
	}

	const loadData = () => {
		LabelManager.initIds()
		AccountManager.processDueAutoRenewals()
		entries.value = AccountManager.getSortedEntries()
		labels.value = LabelManager.getSortedLabels('account')
		paymentMethods.value = AccountManager.getPaymentMethods()
		autoRenewals.value = AccountManager.getAutoRenewals()
		monthOverview.value = AccountManager.getOverview('month')
		monthlyBudget.value = AccountManager.getBudgetSettings().monthlyExpenseBudget
		labelBudgetOverviews.value = AccountManager.getMonthlyLabelBudgetOverviews()
	}

	const budgetRemaining = computed(() => monthlyBudget.value - monthOverview.value.expense)
	const budgetUsedPercent = computed(() => {
		if (monthlyBudget.value <= 0) return 0
		return Math.min(100, Math.round(monthOverview.value.expense / monthlyBudget.value * 100))
	})
	const budgetStatusText = computed(() => {
		if (monthlyBudget.value <= 0) return '还没有设置预算'
		if (budgetRemaining.value < 0) return `已超出 ¥${Math.abs(budgetRemaining.value).toFixed(2)}`
		return `还可用 ¥${budgetRemaining.value.toFixed(2)}`
	})
	const budgetRemainingText = computed(() => {
		if (monthlyBudget.value <= 0) return '未设置'
		if (budgetRemaining.value < 0) return `-¥${Math.abs(budgetRemaining.value).toFixed(2)}`
		return `¥${budgetRemaining.value.toFixed(2)}`
	})

	const visibleLabelBudgetOverviews = computed<LabelBudgetOverview[]>(() => {
		return labelBudgetOverviews.value
			.filter(item => labels.value.some(label => label.id === item.labelId))
			.sort((a, b) => getLabelSortOrder(a.labelId) - getLabelSortOrder(b.labelId))
	})

	const selectedBudgetLabelName = computed(() => {
		const label = labels.value.find(item => item.id === selectedBudgetLabelId.value)
		return label != null ? label.name : '请选择标签'
	})

	const selectedBudgetLabelIndex = computed(() => {
		const index = labels.value.findIndex(item => item.id === selectedBudgetLabelId.value)
		return index >= 0 ? index : 0
	})

	const paymentMethodNames = computed<string[]>(() => {
		return paymentMethods.value.map(method => method.name)
	})

	const selectedPaymentMethodName = computed(() => {
		const method = paymentMethods.value.find(item => item.id === formPaymentMethodId.value)
		return method != null ? method.name : '请选择支付方式'
	})

	const selectedRenewalPaymentMethodIndex = computed(() => {
		const index = paymentMethods.value.findIndex(method => method.id === renewalPaymentMethodId.value)
		return index >= 0 ? index : 0
	})

	const selectedRenewalPaymentMethodName = computed(() => {
		const method = paymentMethods.value.find(item => item.id === renewalPaymentMethodId.value)
		return method != null ? method.name : '请选择支付方式'
	})

	const resetForm = () => {
		editingId.value = 0
		formType.value = 'expense'
		formAmount.value = ''
		formLabelIds.value = []
		formPaymentMethodId.value = AccountManager.getDefaultPaymentMethodId()
		formDate.value = formatDate(Date.now())
		formRemark.value = ''
	}

	const openAddModal = () => {
		resetForm()
		showPaymentSelector.value = false
		showDateSelector.value = false
		showLabelSelector.value = false
		showAddLabelModal.value = false
		showModal.value = true
	}

	const editEntry = (entry: AccountEntry) => {
		editingId.value = entry.id
		formType.value = entry.type
		formAmount.value = `${entry.amount}`
		formLabelIds.value = parseLabelIds(entry.labelIdList)
		formPaymentMethodId.value = entry.paymentMethodId
		formDate.value = formatDate(entry.occurredAt)
		formRemark.value = entry.remark
		showModal.value = true
	}

	const goToSettings = () => {
		uni.navigateTo({
			url: '/pages/account/settings'
		})
	}

	const goToExpenseChart = () => {
		uni.navigateTo({
			url: '/pages/my/account-chart?period=month&type=expense'
		})
	}

	const goToIncomeChart = () => {
		uni.navigateTo({
			url: '/pages/my/account-chart?period=month&type=income'
		})
	}

	const hideModal = () => {
		showModal.value = false
		showPaymentSelector.value = false
		showDateSelector.value = false
		showLabelSelector.value = false
		showAddLabelModal.value = false
		newLabelError.value = ''
	}

	const openBudgetModal = () => {
		budgetAmount.value = monthlyBudget.value > 0 ? `${monthlyBudget.value}` : ''
		budgetError.value = ''
		showBudgetModal.value = true
	}

	const hideBudgetModal = () => {
		showBudgetModal.value = false
		budgetError.value = ''
	}

	const syncLabelBudgetInput = () => {
		const amount = AccountManager.getLabelBudgetAmount(selectedBudgetLabelId.value)
		labelBudgetAmount.value = amount > 0 ? `${amount}` : ''
	}

	const openLabelBudgetModal = (labelId: number) => {
		if (labels.value.length === 0) {
			uni.showToast({ title: '请先新增记账标签', icon: 'none' })
			return
		}

		selectedBudgetLabelId.value = labelId > 0 ? labelId : labels.value[0].id
		labelBudgetError.value = ''
		syncLabelBudgetInput()
		showLabelBudgetModal.value = true
	}

	const hideLabelBudgetModal = () => {
		showLabelBudgetModal.value = false
		labelBudgetError.value = ''
	}

	const clearBudgetError = () => {
		if (budgetError.value.length > 0) {
			budgetError.value = ''
		}
	}

	const clearLabelBudgetError = () => {
		if (labelBudgetError.value.length > 0) {
			labelBudgetError.value = ''
		}
	}

	const onLabelBudgetChange = (e: UTSJSONObject) => {
		const index = getDetailNumberValue(e)
		if (index < 0 || index >= labels.value.length) return
		selectedBudgetLabelId.value = labels.value[index].id
		labelBudgetError.value = ''
		syncLabelBudgetInput()
	}

	const saveBudget = () => {
		const amount = parseFloat(budgetAmount.value)
		if (Number.isNaN(amount) || amount <= 0) {
			budgetError.value = '请输入大于 0 的预算金额'
			return
		}

		if (AccountManager.saveMonthlyExpenseBudget(amount)) {
			hideBudgetModal()
			loadData()
			uni.showToast({ title: '预算已保存', icon: 'success' })
		} else {
			budgetError.value = '保存失败，请稍后再试'
		}
	}

	const clearBudget = () => {
		if (AccountManager.saveMonthlyExpenseBudget(0)) {
			hideBudgetModal()
			loadData()
			uni.showToast({ title: '预算已清空', icon: 'success' })
		} else {
			budgetError.value = '清空失败，请稍后再试'
		}
	}

	const saveLabelBudget = () => {
		if (selectedBudgetLabelId.value <= 0) {
			labelBudgetError.value = '请选择标签'
			return
		}

		const amount = parseFloat(labelBudgetAmount.value)
		if (Number.isNaN(amount) || amount <= 0) {
			labelBudgetError.value = '请输入大于 0 的预算金额'
			return
		}

		if (AccountManager.saveLabelMonthlyBudget(selectedBudgetLabelId.value, amount)) {
			hideLabelBudgetModal()
			loadData()
			uni.showToast({ title: '标签预算已保存', icon: 'success' })
		} else {
			labelBudgetError.value = '保存失败，请稍后再试'
		}
	}

	const clearLabelBudget = () => {
		if (selectedBudgetLabelId.value <= 0) {
			labelBudgetError.value = '请选择标签'
			return
		}

		if (AccountManager.saveLabelMonthlyBudget(selectedBudgetLabelId.value, 0)) {
			hideLabelBudgetModal()
			loadData()
			uni.showToast({ title: '标签预算已清空', icon: 'success' })
		} else {
			labelBudgetError.value = '清空失败，请稍后再试'
		}
	}

	const hideAddLabel = () => {
		showAddLabelModal.value = false
		newLabelError.value = ''
	}

	const openAddLabel = () => {
		newLabelName.value = ''
		newLabelError.value = ''
		newLabelColor.value = '#1F7A72'
		showAddLabelModal.value = true
	}

	const clearNewLabelError = () => {
		if (newLabelError.value.length > 0) {
			newLabelError.value = ''
		}
	}

	const onTypeChange = (e: UTSJSONObject) => {
		formType.value = getDetailStringValue(e) === 'income' ? 'income' : 'expense'
	}

	const onRenewalPaymentMethodChange = (e: UTSJSONObject) => {
		const index = getDetailNumberValue(e)
		if (index < 0 || index >= paymentMethods.value.length) return
		renewalPaymentMethodId.value = paymentMethods.value[index].id
	}

	const onRenewalDateChange = (e: UTSJSONObject) => {
		renewalDate.value = getDetailStringValue(e)
	}

	const toggleFormLabel = (labelId: number) => {
		formLabelIds.value = formLabelIds.value.includes(labelId) ? [] : [labelId]
	}

	const toggleRenewalLabel = (labelId: number) => {
		renewalLabelIds.value = renewalLabelIds.value.includes(labelId) ? [] : [labelId]
	}

	const resetRenewalForm = () => {
		editingRenewalId.value = 0
		renewalName.value = ''
		renewalAmount.value = ''
		renewalPaymentMethodId.value = AccountManager.getDefaultPaymentMethodId()
		renewalDate.value = formatDate(Date.now())
		renewalLabelIds.value = []
		renewalRemark.value = ''
	}

	const openRenewalModal = (renewal: AutoRenewal | null) => {
		if (paymentMethods.value.length === 0) {
			paymentMethods.value = AccountManager.getPaymentMethods()
		}
		showRenewalLabelSelector.value = false
		if (renewal == null) {
			resetRenewalForm()
		} else {
			editingRenewalId.value = renewal.id
			renewalName.value = renewal.name
			renewalAmount.value = `${renewal.amount}`
			renewalPaymentMethodId.value = renewal.paymentMethodId
			renewalDate.value = formatDate(renewal.nextChargeDate)
			renewalLabelIds.value = parseLabelIds(renewal.labelIdList)
			renewalRemark.value = renewal.remark
		}
		showRenewalModal.value = true
	}

	const hideRenewalModal = () => {
		showRenewalModal.value = false
		showRenewalLabelSelector.value = false
	}

	const saveRenewal = () => {
		const amount = parseFloat(renewalAmount.value)
		if (renewalName.value.trim().length === 0) {
			uni.showToast({ title: '请输入名称', icon: 'none' })
			return
		}
		if (Number.isNaN(amount) || amount <= 0) {
			uni.showToast({ title: '请输入正确金额', icon: 'none' })
			return
		}

		let success = false
		if (editingRenewalId.value > 0) {
			const current = autoRenewals.value.find(item => item.id === editingRenewalId.value)
			if (current == null) return
			success = AccountManager.updateAutoRenewal({
				...current,
				name: renewalName.value.trim(),
				amount,
				paymentMethodId: renewalPaymentMethodId.value,
				labelIdList: renewalLabelIds.value.join(','),
				nextChargeDate: new Date(renewalDate.value).getTime(),
				remark: renewalRemark.value.trim()
			})
		} else {
			success = AccountManager.addAutoRenewal({
				name: renewalName.value.trim(),
				amount,
				paymentMethodId: renewalPaymentMethodId.value,
				labelIdList: renewalLabelIds.value.join(','),
				nextChargeDate: new Date(renewalDate.value).getTime(),
				isEnabled: true,
				remark: renewalRemark.value.trim()
			})
		}

		if (success == true) {
			hideRenewalModal()
			loadData()
			uni.showToast({ title: '保存成功', icon: 'success' })
		}
	}

	const toggleRenewal = (renewal: AutoRenewal) => {
		AccountManager.updateAutoRenewal({
			...renewal,
			isEnabled: renewal.isEnabled == false
		})
		loadData()
	}

	const deleteRenewal = (renewalId: number) => {
		uni.showModal({
			title: '确认删除',
			content: '确定删除这个自动续费项目吗？已生成的账单不会删除。',
			success: (res) => {
				if (res.confirm == false) return
				if (AccountManager.deleteAutoRenewal(renewalId)) {
					loadData()
					uni.showToast({ title: '删除成功', icon: 'success' })
				}
			}
		})
	}

	const addAccountLabel = () => {
		const createdName = newLabelName.value.trim()
		if (createdName.length === 0) {
			newLabelError.value = '请输入标签名称'
			uni.showToast({ title: '请输入标签名称', icon: 'none' })
			return
		}

		const existingLabel = LabelManager.getLabelByName(createdName, 'account')
		if (existingLabel != null) {
			formLabelIds.value = [existingLabel.id]
			newLabelError.value = '已存在同名标签，已为你选中'
			uni.showToast({ title: '标签已存在，已选中', icon: 'none' })
			return
		}

		const success = LabelManager.addLabel(createdName, newLabelColor.value, 'account')
		if (success == false) {
			newLabelError.value = '添加失败，请稍后再试'
			uni.showToast({ title: '添加失败', icon: 'none' })
			return
		}

		labels.value = LabelManager.getSortedLabels('account')
		const created = labels.value.find(item => item.name === createdName)
		if (created != null) formLabelIds.value = [created.id]
		newLabelName.value = ''
		newLabelError.value = ''
		newLabelColor.value = '#1F7A72'
		showAddLabelModal.value = false
		uni.showToast({ title: '添加成功', icon: 'success' })
	}

	const saveEntry = () => {
		const amount = parseFloat(formAmount.value)
		if (Number.isNaN(amount) || amount <= 0) {
			uni.showToast({ title: '请输入正确金额', icon: 'none' })
			return
		}

		const payload: AccountEntryInput = {
			type: formType.value,
			amount: amount,
			labelIdList: formLabelIds.value.join(','),
			paymentMethodId: formPaymentMethodId.value,
			autoRenewalId: 0,
			remark: formRemark.value,
			occurredAt: new Date(formDate.value).getTime()
		}

		let success = false
		if (editingId.value > 0) {
			const current = AccountManager.getEntryById(editingId.value)
			if (current == null) return
			const updatedEntry: AccountEntry = {
				id: current.id,
				type: payload.type,
				amount: payload.amount,
				labelIdList: payload.labelIdList,
				paymentMethodId: payload.paymentMethodId != null ? payload.paymentMethodId : AccountManager.getDefaultPaymentMethodId(),
				autoRenewalId: current.autoRenewalId,
				remark: payload.remark,
				occurredAt: payload.occurredAt,
				createTime: current.createTime,
				updateTime: current.updateTime
			}
			success = AccountManager.updateEntry(updatedEntry)
		} else {
			success = AccountManager.addEntry(payload)
		}

		if (success == true) {
			hideModal()
			loadData()
			uni.showToast({ title: '保存成功', icon: 'success' })
		}
	}

	const deleteEntry = (entryId: number) => {
		uni.showModal({
			title: '确认删除',
			content: '确定删除这条记账记录吗？',
			success: (res) => {
				if (res.confirm == false) return
				if (AccountManager.deleteEntry(entryId)) {
					loadData()
					uni.showToast({ title: '删除成功', icon: 'success' })
				}
			}
		})
	}

	onShow(() => {
		if (formDate.value.length === 0) {
			resetForm()
		}
		loadData()
	})
</script>

<style>
