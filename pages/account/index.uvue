	.budget-header {
		flex-direction: row;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: 12px;
	}

	.budget-title {
		display: flex;
		font-size: 16px;
		font-weight: bold;
		color: #24323a;
		margin-bottom: 6px;
	}

	.budget-desc {
		font-size: 12px;
		color: #7b8791;
	}

	.budget-action {
		height: 34px;
		line-height: 34px;
		padding: 0 14px;
		border-radius: 17px;
		background-color: #1f7a72;
		color: #fff;
		font-size: 13px;
		flex-shrink: 0;
	}

	.budget-numbers {
		flex-direction: row;
		justify-content: space-between;
		margin-bottom: 8px;
	}

	.budget-used,
	.budget-total {
		font-size: 12px;
