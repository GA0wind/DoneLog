<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<view class="profile-header">
			<text class="profile-kicker">我的</text>
			<text class="profile-title">设置中心</text>
			<text class="profile-desc">业务入口已经放回事件和记账页，这里只保留数据维护与轻量概览。</text>
		</view>

		<view class="period-switch">
			<view class="period-option" :class="{ 'period-active': period === 'week' }" @click="setPeriod('week')"><text>本周</text></view>
			<view class="period-option" :class="{ 'period-active': period === 'month' }" @click="setPeriod('month')"><text>本月</text></view>
		</view>

		<view class="list-group">
			<text class="group-title">{{period === 'week' ? '本周概览' : '本月概览'}}</text>
			<view class="list-row plain-row">
				<view class="row-icon muted-icon"><text class="row-icon-text">✓</text></view>
				<view class="row-main">
					<text class="row-title">事件完成</text>
					<text class="row-desc">{{period === 'week' ? '本周' : '本月'}}已经完成的事件次数</text>
				</view>
				<text class="row-value">{{eventTotalCount}} 次</text>
			</view>
			<view class="list-row plain-row">
				<view class="row-icon expense-icon"><text class="row-icon-text">¥</text></view>
				<view class="row-main">
					<text class="row-title">记账支出</text>
					<text class="row-desc">{{period === 'week' ? '本周' : '本月'}}支出合计</text>
				</view>
				<text class="row-value">¥{{accountOverview.expense.toFixed(2)}}</text>
			</view>
			<view class="list-row last-row plain-row">
				<view class="row-icon income-icon"><text class="row-icon-text">收</text></view>
				<view class="row-main">
					<text class="row-title">记账收入</text>
					<text class="row-desc">{{period === 'week' ? '本周' : '本月'}}收入合计</text>
				</view>
				<text class="row-value">¥{{accountOverview.income.toFixed(2)}}</text>
			</view>
		</view>

		<view class="list-group">
			<text class="group-title">事件标签完成统计</text>
			<view class="list-row plain-row" v-for="item in eventStats" :key="item.labelId">
				<view class="row-main"><text class="row-title">{{getEventLabelName(item.labelId)}}</text></view>
				<text class="row-value">{{item.count}} 次</text>
			</view>
			<view class="list-row last-row plain-row" v-if="eventStats.length === 0"><text class="row-desc">暂无完成记录</text></view>
		</view>

		<view class="list-group">
			<text class="group-title">数据维护</text>
			<view class="list-row" @click="exportBackup">
				<view class="row-icon"><text class="row-icon-text">出</text></view>
				<view class="row-main">
					<text class="row-title">导出备份</text>
					<text class="row-desc">复制当前数据，包含私人记录，请妥善保存</text>
				</view>
				<text class="row-arrow">›</text>
			</view>
			<view class="list-row" @click="showImportDialog">
				<view class="row-icon"><text class="row-icon-text">入</text></view>
				<view class="row-main">
					<text class="row-title">导入备份</text>
					<text class="row-desc">从之前导出的 JSON 恢复数据</text>
				</view>
				<text class="row-arrow">›</text>
			</view>
			<view class="list-row" @click="repairData">
				<view class="row-icon"><text class="row-icon-text">检</text></view>
				<view class="row-main">
					<text class="row-title">数据自检</text>
					<text class="row-desc">修正标签引用、ID 冲突和排序异常</text>
				</view>
				<text class="row-arrow">›</text>
			</view>
			<view class="list-row last-row danger-row" @click="openResetDefaultLabelsDialog">
				<view class="row-icon danger-icon"><text class="row-icon-text">重</text></view>
				<view class="row-main">
					<text class="row-title danger-title">重置默认标签</text>
					<text class="row-desc">恢复事件和记账的默认标签列表</text>
				</view>
				<text class="row-arrow danger-arrow">›</text>
			</view>
		</view>

		<view class="list-group">
			<text class="group-title">应用</text>
			<view class="list-row last-row plain-row">
				<view class="row-icon muted-icon"><text class="row-icon-text">版</text></view>
				<view class="row-main">
					<text class="row-title">当前版本</text>
					<text class="row-desc">DoneLog / 做完记</text>
				</view>
				<text class="row-value">1.0.9</text>
			</view>
		</view>

		<view class="modal" v-if="showResetLabelsModal">
			<view class="modal-content" @click.stop>
				<text class="modal-title">重置默认标签</text>
				<text class="modal-desc">会恢复事件标签和记账标签的默认列表，并移除记录上的旧标签关联；事件、完成记录和记账记录不会删除。</text>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideResetDefaultLabelsDialog">取消</button>
					<button class="confirm-btn danger-confirm-btn" @click.stop="confirmResetDefaultLabels">确认重置</button>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showImportModal" @click="hideImportDialog">
			<view class="modal-content" @click.stop>
				<text class="modal-title">导入备份</text>
				<textarea class="import-textarea" v-model="importText" placeholder="粘贴导出的备份 JSON" />
				<text class="error-tip" v-if="importError">{{importError}}</text>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideImportDialog">取消</button>
					<button class="confirm-btn" @click.stop="importBackup">导入</button>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { EventManager, EventLabelStats, StatsPeriod } from '@/utils/eventManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { AccountManager, AccountOverview } from '@/utils/accountManager.uts'
	import { ShiftManager } from '@/utils/shiftManager.uts'
	import { StorageUtils, Label } from '@/utils/storage.uts'

	EventManager.initIds()
	LabelManager.initIds()
	AccountManager.initIds()

	const period = ref<StatsPeriod>('week')
	const eventTotalCount = ref(0)
	const eventStats = ref<EventLabelStats[]>([])
	const eventLabels = ref<Label[]>([])
	const accountOverview = ref<AccountOverview>({ income: 0, expense: 0, count: 0 })
	const showImportModal = ref(false)
	const showResetLabelsModal = ref(false)
	const importText = ref('')
	const importError = ref('')

	const loadData = () => {
		LabelManager.repairLabelData()
		const stats = EventManager.getCompletionStatsByLabel(period.value)
		eventStats.value = stats
		eventLabels.value = LabelManager.getSortedLabels('event')
		eventTotalCount.value = stats.reduce((sum: number, item: EventLabelStats): number => sum + item.count, 0)
		accountOverview.value = AccountManager.getOverview(period.value)
	}

	const setPeriod = (value: StatsPeriod) => {
		period.value = value
		loadData()
	}

	const getEventLabelName = (labelId: number): string => {
		if (labelId === 0) return '未分类'
		const label = eventLabels.value.find(item => item.id === labelId)
		return label != null ? label.name : '未知标签'
	}

	const exportBackup = () => {
		const backup = StorageUtils.exportData()
		uni.setClipboardData({
			data: backup,
			success: () => {
				uni.showToast({ title: '备份已复制', icon: 'success' })
			},
			fail: () => {
				uni.showToast({ title: '复制失败', icon: 'none' })
			}
		})
	}

	const repairData = () => {
		const labelSuccess = LabelManager.repairLabelData()
		EventManager.initIds()
		AccountManager.initIds()
		if (labelSuccess == false) {
			uni.showToast({ title: '自检修复失败', icon: 'none' })
			return
		}
		loadData()
		uni.showToast({ title: '自检完成', icon: 'success' })
	}

	const showImportDialog = () => {
		importText.value = ''
		importError.value = ''
		showImportModal.value = true
	}

	const hideImportDialog = () => {
		showImportModal.value = false
		importError.value = ''
	}

	const importBackup = () => {
		if (importText.value.trim().length === 0) {
			importError.value = '请先粘贴备份内容'
			return
		}

		const success = StorageUtils.importData(importText.value.trim())
		if (success == false) {
			importError.value = '导入失败，请确认备份内容完整'
			uni.showToast({ title: '导入失败', icon: 'none' })
			return
		}

		EventManager.initIds()
		LabelManager.initIds()
		AccountManager.initIds()
		ShiftManager.cleanupExpired()
		hideImportDialog()
		loadData()
		uni.showToast({ title: '导入成功', icon: 'success' })
	}

	const openResetDefaultLabelsDialog = () => {
		showResetLabelsModal.value = true
	}

	const hideResetDefaultLabelsDialog = () => {
		showResetLabelsModal.value = false
	}

	const confirmResetDefaultLabels = () => {
		const success = LabelManager.resetAllDefaultLabels()
		const eventReset = LabelManager.getSortedLabels('event').length > 0
		const accountReset = LabelManager.getSortedLabels('account').some(label => label.id > 10000)
		if (success == false || eventReset == false || accountReset == false) {
			uni.showToast({ title: '重置失败', icon: 'none' })
			return
		}
		hideResetDefaultLabelsDialog()
		loadData()
		uni.showToast({ title: '已重置标签', icon: 'success' })
	}

	onShow(() => {
		loadData()
	})

	onLoad(() => {
		loadData()
	})
</script>

<style>
	.container {
		flex: 1;
		background-color: #f4efe7;
		padding: 16px;
		padding-bottom: 100px;
	}

	.profile-header {
		background: linear-gradient(135deg, #24323a, #1f7a72);
		border-radius: 24px;
		padding: 18px;
		margin-bottom: 14px;
		box-shadow: 0 12px 28px rgba(31, 122, 114, 0.16);
	}

	.profile-kicker {
		font-size: 12px;
		color: #bfe4dc;
		margin-bottom: 8px;
	}

	.profile-title {
		font-size: 24px;
		font-weight: bold;
		color: #fff9f2;
		margin-bottom: 8px;
	}

	.profile-desc {
		font-size: 13px;
		line-height: 1.6;
		color: #d8e6e3;
	}

	.list-group {
		background-color: #fffaf3;
		border-radius: 24px;
		padding: 12px 14px;
		margin-bottom: 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
		box-shadow: 0 12px 28px rgba(36, 50, 58, 0.05);
	}

	.period-switch {
		flex-direction: row;
		background-color: #fffaf3;
		border-radius: 18px;
		padding: 4px;
		margin-bottom: 14px;
	}

	.period-option {
		flex: 1;
		align-items: center;
		padding: 10px;
		border-radius: 14px;
		color: #7b8791;
	}

	.period-active {
		background-color: #dff3ef;
		color: #1f7a72;
	}

	.group-title {
		font-size: 13px;
		font-weight: 600;
		color: #8792a1;
		margin: 2px 0 8px;
	}

	.list-row {
		flex-direction: row;
		align-items: center;
		padding: 13px 0;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #efe3d7;
	}

	.last-row {
		border-bottom-width: 0;
	}

	.row-icon {
		width: 34px;
		height: 34px;
		border-radius: 17px;
		background-color: #e8f4f2;
		align-items: center;
		justify-content: center;
		margin-right: 12px;
	}

	.muted-icon {
		background-color: #f2ebe2;
	}

	.expense-icon,
	.danger-icon {
		background-color: #f8ddd3;
	}

	.income-icon {
		background-color: #dff3ef;
	}

	.row-icon-text {
		font-size: 13px;
		font-weight: bold;
		color: #1f7a72;
	}

	.row-main {
		flex: 1;
		min-width: 0;
	}

	.row-title {
		font-size: 15px;
		font-weight: 600;
		color: #24323a;
		margin-bottom: 4px;
	}

	.danger-title {
		color: #c45d42;
	}

	.row-desc {
		font-size: 12px;
		color: #7b8791;
		line-height: 1.35;
	}

	.row-value {
		font-size: 14px;
		font-weight: 600;
		color: #24323a;
		margin-left: 10px;
	}

	.row-arrow {
		font-size: 26px;
		color: #b7a995;
		margin-left: 10px;
	}

	.danger-arrow {
		color: #c45d42;
	}

	.modal {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.42);
		justify-content: center;
		align-items: center;
		padding: 18px;
	}

	.modal-content {
		width: 84%;
		background-color: #fffaf3;
		border-radius: 24px;
		padding: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
		box-shadow: 0 18px 40px rgba(36, 50, 58, 0.14);
	}

	.modal-title {
		font-size: 18px;
		font-weight: bold;
		color: #24323a;
		margin-bottom: 10px;
	}

	.modal-desc {
		font-size: 13px;
		line-height: 1.6;
		color: #7b8791;
		margin-bottom: 16px;
	}

	.import-textarea {
		min-height: 180px;
		background-color: #fffdf9;
		border-radius: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #eee2d7;
		padding: 12px;
		font-size: 13px;
		color: #24323a;
		margin-bottom: 8px;
	}

	.error-tip {
		font-size: 12px;
		line-height: 1.5;
		color: #e07a5f;
		margin-bottom: 8px;
	}

	.modal-footer {
		flex-direction: row;
		align-items: center;
		margin-top: 4px;
	}

	.cancel-btn,
	.confirm-btn {
		flex: 1;
		height: 44px;
		line-height: 44px;
		border-radius: 22px;
		font-size: 14px;
	}

	.cancel-btn {
		background-color: #f2ebe2;
		color: #4d5b67;
		margin-right: 10px;
	}

	.confirm-btn {
		background-color: #1f7a72;
		color: #fff;
	}

	.danger-confirm-btn {
		background-color: #e07a5f;
	}
</style>
