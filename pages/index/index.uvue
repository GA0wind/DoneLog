<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<view class="today-card">
			<view class="today-header">
				<view>
					<text class="today-kicker">今日概览</text>
					<text class="today-title">今天先抓重点</text>
				</view>
				<view class="today-badge" @click="goToAdd">
					<text class="today-badge-text">+ 事件</text>
				</view>
			</view>
			<view class="today-grid">
				<view class="today-metric">
					<text class="today-value">{{todayDueEventCount}}</text>
					<text class="today-label">待处理事件</text>
				</view>
				<view class="today-metric" @click="goToAccount">
					<text class="today-value expense">¥{{todayOverview.expense.toFixed(2)}}</text>
					<text class="today-label">今日支出</text>
				</view>
				<view class="today-metric last-today-metric" @click="goToAccount">
					<text class="today-value income">¥{{todayOverview.income.toFixed(2)}}</text>
					<text class="today-label">今日收入</text>
				</view>
			</view>
		</view>

		<!-- 搜索和筛选 -->
		<view class="filter-bar">
			<input class="search-input" v-model="searchKeyword" placeholder="搜索事件..." />
			<view class="filter-btn" @click="openLabelFilter">
				<text class="filter-btn-text">{{selectedLabelText}}</text>
				<text class="arrow">▼</text>
			</view>
			<view class="filter-btn" @click="openStatusFilter">
				<text class="filter-btn-text">{{selectedStatusText}}</text>
				<text class="arrow">▼</text>
			</view>
		</view>

		<view class="quick-row">
			<text class="quick-count">当前 {{filteredEvents.length}} 个</text>
			<view class="quick-actions">
				<view class="quick-manage-btn shift-btn" @click="goToShifts">
					<text class="quick-manage-text">班次提醒</text>
				</view>
				<view class="quick-manage-btn" @click="goToEventLabels">
					<text class="quick-manage-text">标签管理</text>
				</view>
			</view>
		</view>

		<!-- 事件列表 -->
		<view class="event-list">
			<view 
				class="event-card" 
				v-for="event in filteredEvents" 
				:key="event.id"
				:class="{ 'overdue': isOverdue(event), 'terminated': event.isTerminated }"
				@click="goToDetail(event.id)"
			>
				<view class="event-header">
					<text class="event-name">{{event.name}}</text>
					<text class="event-days" :class="{ 'overdue-text': isOverdue(event), 'terminated-text': event.isTerminated }">
						{{getDaysText(event)}}
					</text>
				</view>
				<view class="event-remark">
					<text class="remark-text" :class="{ 'remark-placeholder': event.remark.length === 0 }">{{event.remark.length > 0 ? getShortRemark(event.remark) : '占位备注'}}</text>
				</view>
				<view class="event-footer">
					<view class="event-tags">
						<text 
							class="tag" 
							v-for="labelId in getEventLabelIds(event)" 
							:key="labelId"
							:style="{ backgroundColor: getLabelColor(labelId) }"
						>
							{{getLabelName(labelId)}}
						</text>
					</view>
					<view class="footer-actions" v-if="canComplete(event)">
						<view class="action-btn complete-btn" @click.stop="markComplete(event.id)">
							<text class="action-btn-text complete-btn-text">完成</text>
						</view>
					</view>
				</view>
			</view>
			<view class="empty-state-wrap" v-if="filteredEvents.length === 0">
				<view class="empty-tip">
					<text class="empty-icon">◌</text>
					<text class="empty-title">暂时没有待办事件</text>
					<text class="empty-desc">新增一个周期事项，或切换筛选条件看看。</text>
				</view>
			</view>
		</view>

		<!-- 浮动添加按钮 -->
		<view class="add-btn" @click="goToAdd">
			<text class="add-icon">+</text>
		</view>

		<view class="modal" v-if="showLabelFilterModal" @click="closeLabelFilter">
			<view class="filter-modal-content" @click.stop>
				<text class="modal-title">选择标签</text>
				<view
					class="filter-option"
					v-for="(option, index) in labelOptions"
					:key="option.id"
					:class="{ active: selectedLabelOptionIndex === index }"
					@click.stop="selectLabelFilter(index)"
				>
					<view class="filter-option-left">
						<view class="label-color-dot" v-if="option.id > 0" :style="{ backgroundColor: option.color }"></view>
						<text class="filter-option-text" :class="{ active: selectedLabelOptionIndex === index }">{{option.name}}</text>
					</view>
					<text class="filter-option-check" v-if="selectedLabelOptionIndex === index">✓</text>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showStatusFilterModal" @click="closeStatusFilter">
			<view class="filter-modal-content" @click.stop>
				<text class="modal-title">选择状态</text>
				<view
					class="filter-option"
					v-for="(option, index) in statusOptions"
					:key="option.id"
					:class="{ active: selectedStatusOptionIndex === index }"
					@click.stop="selectStatusFilter(index)"
				>
					<text class="filter-option-text" :class="{ active: selectedStatusOptionIndex === index }">{{option.name}}</text>
					<text class="filter-option-check" v-if="selectedStatusOptionIndex === index">✓</text>
				</view>
			</view>
		</view>

		<view class="modal" v-if="showSetup">
			<view class="filter-modal-content">
				<text class="modal-title">首次使用 · 初始化</text>
				<text class="setup-description">记账 AI 分类使用你的 DeepSeek API Key，描述和标签会发送给 DeepSeek。密钥只保存在本机；其他记录功能不需要密钥。</text>
				<input class="setup-input" :password="true" v-model="setupKey" placeholder="填写 DeepSeek API Key" />
				<text class="setup-error" v-if="setupError.length > 0">{{setupError}}</text>
				<button class="setup-button" @click="completeSetup">保存并开始使用</button>
				<text class="setup-skip" @click="skipSetup">暂不启用 AI，先使用记录功能</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { EventLatestCompletion, EventManager } from '@/utils/eventManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { AccountManager, AccountOverview } from '@/utils/accountManager.uts'
	import { Event, Label } from '@/utils/storage.uts'
	import { AccountAi } from '@/utils/accountAi.uts'

	type StatusOption = {
		id: number
		name: string
	}

	// 初始化ID
	EventManager.initIds()
	LabelManager.initIds()

	// 响应式数据
	const events = ref<Event[]>([])
	const labels = ref<Label[]>([])
	const searchKeyword = ref('')
	const selectedLabel = ref<Label | null>(null)
	const latestCompletionDates = ref<EventLatestCompletion[]>([])
	const todayCompletedEventIds = ref<number[]>([])
	const todayOverview = ref<AccountOverview>({ income: 0, expense: 0, count: 0 })
	const todayDueEventCount = ref(0)
	const showLabelFilterModal = ref(false)
	const showStatusFilterModal = ref(false)
	const showSetup = ref(false)
	const setupKey = ref('')
	const setupError = ref('')
	const setupStorageKey = 'donelog_initialized'

	const completeSetup = () => {
		if (setupKey.value.trim().length < 8) {
			setupError.value = '请填写有效的 API Key'
			return
		}
		if (AccountAi.saveApiKey(setupKey.value) == false) {
			setupError.value = '保存失败，请重试'
			return
		}
		uni.setStorageSync(setupStorageKey, true)
		showSetup.value = false
		setupKey.value = ''
		setupError.value = ''
	}

	const skipSetup = () => {
		uni.setStorageSync(setupStorageKey, true)
		showSetup.value = false
	}
	const labelOptions = ref<Label[]>([{ id: 0, name: '全部标签', color: '', sortOrder: 0 }])
	const selectedStatus = ref<StatusOption | null>({ id: 1, name: '进行中' })
	const statusOptions = ref<StatusOption[]>([
		{ id: 0, name: '全部状态' },
		{ id: 1, name: '进行中' },
		{ id: 2, name: '已完成' },
		{ id: 3, name: '已终止' }
	])

	// 获取标签选项
	const getLabelOptions = () => {
		const allLabels = LabelManager.getSortedLabels('event')
		labelOptions.value = [{ id: 0, name: '全部标签', color: '', sortOrder: 0 }, ...allLabels]
	}

	// 加载数据
	const loadData = () => {
		events.value = EventManager.getSortedEvents(true, selectedLabel.value != null ? selectedLabel.value.id : null)
		labels.value = LabelManager.getSortedLabels('event')
		latestCompletionDates.value = EventManager.getLatestCompletionDates()
		todayCompletedEventIds.value = EventManager.getCompletedEventIdsOnDate(Date.now())
		const todayStart = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate()).getTime()
		todayOverview.value = AccountManager.getOverviewByDate(todayStart)
		todayDueEventCount.value = EventManager.getSortedEvents(true, null).filter((event): boolean => {
			if (event.isTerminated) return false
			if (todayCompletedEventIds.value.includes(event.id)) return false
			const item = latestCompletionDates.value.find(record => record.eventId === event.id)
			const lastCompleteDate = item != null ? item.lastCompleteDate : null
			if (EventManager.isFixedDateCompleted(event, lastCompleteDate)) return false
			return EventManager.calculateDaysUntilDue(event, lastCompleteDate) <= 0
		}).length
		getLabelOptions()
	}

	const getEventLabelIds = (event: Event): number[] => {
		if (event.labelIdList.length === 0) return []
		const validLabelIds = labels.value.map(label => label.id)
		return event.labelIdList
			.split(',')
			.map(id => parseInt(id))
			.filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
	}

	const getLastCompleteDate = (event: Event): number | null => {
		const item = latestCompletionDates.value.find(record => record.eventId === event.id)
		return item != null ? item.lastCompleteDate : null
	}

	const isCompletedToday = (eventId: number): boolean => {
		return todayCompletedEventIds.value.includes(eventId)
	}

	const isCompletedEvent = (event: Event): boolean => {
		const lastCompleteDate = getLastCompleteDate(event)
		return isCompletedToday(event.id)
			|| EventManager.isFixedDateCompleted(event, lastCompleteDate)
			|| (event.isTerminated && lastCompleteDate != null)
	}

	const matchesStatus = (event: Event): boolean => {
		if (selectedStatus.value == null || selectedStatus.value.id === 0) {
			return true
		}

		if (selectedStatus.value.id === 1) {
			return event.isTerminated == false && isCompletedEvent(event) == false
		}

		if (selectedStatus.value.id === 2) {
			return isCompletedEvent(event)
		}

		return event.isTerminated
	}

	const getEventDisplayGroup = (event: Event): number => {
		if (isCompletedEvent(event)) {
			return 1
		}
		if (event.isTerminated) {
			return 2
		}
		return 0
	}

	const getCompletionSortTime = (event: Event): number => {
		const lastCompleteDate = getLastCompleteDate(event)
		return lastCompleteDate != null ? lastCompleteDate : 0
	}

	const compareEventsForDisplay = (a: Event, b: Event): number => {
		if (selectedStatus.value != null && selectedStatus.value.id === 3) {
			return 0
		}

		const groupA = getEventDisplayGroup(a)
		const groupB = getEventDisplayGroup(b)
		if (groupA !== groupB) {
			return groupA - groupB
		}

		if (groupA === 1) {
			return getCompletionSortTime(b) - getCompletionSortTime(a)
		}

		if (groupA === 2) {
			return b.terminatedAt - a.terminatedAt
		}

		return 0
	}

	const selectedLabelText = computed(() => {
		const label = selectedLabel.value
		return label != null ? label.name : '全部标签'
	})

	const selectedStatusText = computed(() => {
		const status = selectedStatus.value
		return status != null ? status.name : '全部状态'
	})

	const selectedLabelOptionIndex = computed(() => {
		const label = selectedLabel.value
		if (label == null) return 0
		const index = labelOptions.value.findIndex(item => item.id === label.id)
		return index >= 0 ? index : 0
	})

	const selectedStatusOptionIndex = computed(() => {
		const status = selectedStatus.value
		if (status == null) return 0
		const index = statusOptions.value.findIndex(item => item.id === status.id)
		return index >= 0 ? index : 0
	})

	// 筛选事件
	const filteredEvents = computed<Event[]>(() => {
		return events.value.filter((event): boolean => {
			if (matchesStatus(event) == false) {
				return false
			}

			if (searchKeyword.value.length === 0) {
				return true
			}

			return event.name.toLowerCase().includes(searchKeyword.value.toLowerCase())
		}).sort((a, b) => compareEventsForDisplay(a, b))
	})

	const canComplete = (event: Event): boolean => {
		if (event.isTerminated) {
			return false
		}
		if (isCompletedToday(event.id)) {
			return false
		}
		return EventManager.isFixedDateCompleted(event, getLastCompleteDate(event)) == false
	}

	// 获取标签名称
	const getLabelName = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.name : ''
	}

	// 获取标签颜色
	const getLabelColor = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.color : '#007AFF'
	}

	// 获取短备注
	const getShortRemark = (remark: string): string => {
		if (remark.length === 0) return ''
		return remark.length > 20 ? remark.substring(0, 20) + '...' : remark
	}

	// 判断是否过期
	const isOverdue = (event: Event): boolean => {
		if (EventManager.isFixedDateCompleted(event, getLastCompleteDate(event))) {
			return false
		}
		const daysUntilDue = EventManager.calculateDaysUntilDue(event, getLastCompleteDate(event))
		return daysUntilDue < 0
	}

	// 获取天数文本
	const getDaysText = (event: Event): string => {
		const lastCompleteDate = getLastCompleteDate(event)
		if (isCompletedToday(event.id)) {
			return '已完成'
		}
		if (EventManager.isFixedDateCompleted(event, lastCompleteDate) || (event.isTerminated && lastCompleteDate != null)) {
			return '已完成'
		}
		if (event.isTerminated) {
			return '已终止'
		}

		const daysUntilDue = EventManager.calculateDaysUntilDue(event, lastCompleteDate)

		if (daysUntilDue === 0) {
			return '今天'
		} else if (daysUntilDue < 0) {
			return `已过去 ${Math.abs(daysUntilDue)} 天`
		} else {
			return `${daysUntilDue} 天后`
		}
	}

	// 标记完成
	const markComplete = (eventId: number) => {
		const cachedEvent = events.value.find(item => item.id === eventId)
		const event = cachedEvent != null ? cachedEvent : EventManager.getEventById(eventId)
		if (event == null) return
		if (event.nextDueDate > 0) {
			uni.navigateTo({
				url: `/pages/event/complete?id=${eventId}`
			})
			return
		}

		const success = EventManager.markEventComplete(eventId)
		if (success == false) {
			uni.showToast({
				title: '今天已完成过',
				icon: 'none'
			})
			return
		}

		if (event.intervalDays < 0) {
			EventManager.terminateEvent(eventId)
		}
		loadData()
		uni.showToast({
			title: '已完成',
			icon: 'success'
		})
	}

	const openLabelFilter = () => {
		showLabelFilterModal.value = true
	}

	const closeLabelFilter = () => {
		showLabelFilterModal.value = false
	}

	const selectLabelFilter = (index: number) => {
		if (index === 0) {
			selectedLabel.value = null
		} else {
			selectedLabel.value = labelOptions.value[index]
		}
		closeLabelFilter()
		loadData()
	}

	const openStatusFilter = () => {
		showStatusFilterModal.value = true
	}

	const closeStatusFilter = () => {
		showStatusFilterModal.value = false
	}

	const selectStatusFilter = (index: number) => {
		if (index === 0) {
			selectedStatus.value = null
		} else {
			selectedStatus.value = statusOptions.value[index]
		}
		closeStatusFilter()
		loadData()
	}

	// 跳转到添加页面
	const goToAdd = () => {
		uni.navigateTo({
			url: '/pages/event/add'
		})
	}

	const goToAccount = () => {
		uni.switchTab({
			url: '/pages/account/index'
		})
	}

	const goToEventLabels = () => {
		uni.setStorageSync('donelog_label_manage_kind', 'event')
		uni.navigateTo({
			url: '/pages/my/labels?kind=event'
		})
	}

	const goToShifts = () => {
		uni.navigateTo({ url: '/pages/shift/index' })
	}

	// 跳转到详情页面
	const goToDetail = (eventId: number) => {
		uni.navigateTo({
			url: `/pages/event/detail?id=${eventId}`
		})
	}

	// 加载更多
	const loadMore = () => {
		// 预留分页功能
	}

	// 下拉刷新
	onPullDownRefresh(() => {
		loadData()
		uni.stopPullDownRefresh()
	})

	// 页面显示时加载数据
	onShow(() => {
		loadData()
		showSetup.value = uni.getStorageSync(setupStorageKey) !== true && AccountAi.getApiKey().length === 0
	})
</script>

<style>
	.container {
		flex: 1;
		background-color: #f4efe7;
		padding-bottom: 100px;
	}

	.today-card {
		background: linear-gradient(135deg, #24323a, #1f7a72);
		margin: 10px 14px 8px;
		padding: 12px;
		border-radius: 20px;
		box-shadow: 0 12px 24px rgba(31, 122, 114, 0.16);
	}

	.today-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 10px;
	}

	.today-kicker {
		font-size: 12px;
		color: #bfe4dc;
		margin-bottom: 6px;
	}

	.today-title {
		font-size: 20px;
		font-weight: bold;
		color: #fff9f2;
	}

	.today-badge {
		height: 32px;
		padding: 0 10px;
		border-radius: 16px;
		background-color: rgba(255, 255, 255, 0.14);
		justify-content: center;
		align-items: center;
		border-width: 1px;
		border-style: solid;
		border-color: rgba(255, 255, 255, 0.2);
	}

	.today-badge-text {
		font-size: 12px;
		color: #fff9f2;
		font-weight: 600;
	}

	.today-grid {
		flex-direction: row;
	}

	.today-metric {
		flex: 1;
		background-color: rgba(255, 255, 255, 0.12);
		border-radius: 16px;
		padding: 10px 8px;
		margin-right: 8px;
		min-width: 0;
	}

	.last-today-metric {
		margin-right: 0;
	}

	.today-value {
		font-size: 16px;
		font-weight: bold;
		color: #fff9f2;
		margin-bottom: 5px;
	}

	.today-value.expense {
		color: #ffd8ca;
	}

	.today-value.income {
		color: #c9f0e8;
	}

	.today-label {
		font-size: 10px;
		color: #d8e6e3;
	}

	/* 搜索和筛选 */
	.filter-bar {
		background-color: #fff9f2;
		margin: 10px 14px 8px;
		padding: 8px;
		flex-direction: row;
		align-items: center;
		border-radius: 22px;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
		box-shadow: 0 8px 24px rgba(36, 50, 58, 0.06);
	}

	.search-input {
		flex: 1;
		height: 34px;
		background-color: #fffdf9;
		border-radius: 20px;
		padding: 0 15px;
		font-size: 13px;
		margin-right: 10px;
		color: #24323a;
		border-width: 1px;
		border-style: solid;
		border-color: #eee2d7;
	}

	.filter-btn {
		flex-direction: row;
		align-items: center;
		padding: 7px 10px;
		background-color: #f2ebe2;
		border-radius: 16px;
		font-size: 12px;
		color: #4d5b67;
		margin-left: 6px;
	}

	.filter-btn-text {
		font-size: 12px;
		color: #24323a;
		lines: 1;
		text-overflow: ellipsis;
	}

	.arrow {
		margin-left: 5px;
		font-size: 10px;
		color: #8792a1;
	}

	.quick-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin: 0 14px 8px;
	}

	.quick-actions { flex-direction: row; }
	.shift-btn { margin-right: 8px; }

	.quick-manage-btn {
		height: 30px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 0 12px;
		border-radius: 15px;
		background-color: #fff9f2;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
	}

	.quick-manage-text {
		font-size: 12px;
		color: #1f7a72;
		font-weight: 600;
		line-height: 30px;
	}

	.quick-count {
		font-size: 12px;
		color: #8792a1;
	}

	/* 事件列表 */
	.event-list {
		flex: 1;
		padding: 6px 14px 142px;
	}

	.event-card {
		background-color: #fffdf9;
		border-radius: 22px;
		padding: 14px 16px 12px;
		margin-bottom: 10px;
		border-width: 1px;
		border-style: solid;
		border-color: #ecdfd2;
		box-shadow: 0 10px 24px rgba(31, 122, 114, 0.08);
		min-height: 112px;
	}

	.event-card.overdue {
		border-left: 5px solid #e07a5f;
	}

	.event-card.terminated {
		opacity: 0.68;
		background-color: #f8f1e9;
	}

	.event-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 6px;
	}

	.event-name {
		font-size: 19px;
		color: #24323a;
		font-weight: bold;
