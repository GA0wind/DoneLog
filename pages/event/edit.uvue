<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<view class="form">
			<!-- 事件名称 -->
			<view class="form-item">
				<text class="label">事件名称 *</text>
				<input class="input" v-model="eventName" placeholder="请输入事件名称" />
			</view>

			<!-- 标签选择 -->
			<view class="form-item">
				<text class="label">选择标签</text>
				<view class="tag-selector" @click="showLabelModal">
					<view class="selected-tags">
						<text 
							class="tag" 
							v-for="labelId in selectedLabelIds" 
							:key="labelId"
							:style="{ backgroundColor: getLabelColor(labelId) }"
						>
							{{getLabelName(labelId)}}
						</text>
						<text class="placeholder" v-if="selectedLabelIds.length === 0">请选择标签</text>
					</view>
					<text class="arrow">▼</text>
				</view>
			</view>

			<!-- 重复方式选择 -->
			<view class="form-item">
				<text class="label">重复方式</text>
				<view class="repeat-options">
					<view class="radio-item" @click="selectRepeatType('interval')">
						<view class="radio-dot" :class="{ active: repeatType === 'interval' }">
							<text class="radio-dot-check" v-if="repeatType === 'interval'">✓</text>
						</view>
						<text class="radio-text">按间隔周期</text>
					</view>
					<view class="radio-item" @click="selectRepeatType('date')">
						<view class="radio-dot" :class="{ active: repeatType === 'date' }">
							<text class="radio-dot-check" v-if="repeatType === 'date'">✓</text>
						</view>
						<text class="radio-text">自定义下次完成时间</text>
					</view>
					<view class="radio-item" @click="selectRepeatType('single')">
						<view class="radio-dot" :class="{ active: repeatType === 'single' }">
							<text class="radio-dot-check" v-if="repeatType === 'single'">✓</text>
						</view>
						<text class="radio-text">不重复</text>
					</view>
				</view>
			</view>

			<!-- 间隔天数 -->
			<view class="form-item" v-if="showIntervalSettings">
				<text class="label">{{intervalFieldLabel}}</text>
				<view class="interval-unit-row">
					<view
						class="interval-unit-chip"
						v-for="option in intervalUnitOptions"
						:key="option.value"
						:class="{ active: intervalUnit === option.value }"
						@click="selectIntervalUnit(option.value)"
					>
						<text class="interval-unit-chip-text" :class="{ active: intervalUnit === option.value }">{{option.label}}</text>
					</view>
				</view>
				<input 
					class="input" 
					type="number" 
					v-model="intervalDays" 
					:placeholder="intervalPlaceholder"
				/>
				<text class="field-tip">{{intervalHelperText}}</text>
			</view>

			<!-- 下次完成时间 -->
			<view class="form-item" v-if="showDateSettings">
				<text class="label">下次完成时间</text>
				<view class="picker" @click="openDateSelector">
					<text>{{nextDueDate.length > 0 ? nextDueDate : '请选择日期'}}</text>
				</view>
			</view>

			<view class="form-item">
				<text class="label">提醒通知</text>
				<label class="switch-row">
					<switch :checked="notifyEnabled" color="#1F7A72" @change="onNotifyEnabledChange" />
					<text class="switch-text">开启事件提醒</text>
				</label>
				<picker v-if="notifyEnabled" mode="time" :value="notifyTime" @change="onNotifyTimeChange">
					<view class="picker notify-time-picker">
						<text>{{notifyTime}}</text>
					</view>
				</picker>
				<text class="field-tip" v-if="notifyEnabled">不重复事项会每天提醒；重复事项从应完成日开始每天提醒，直到完成。</text>
			</view>

			<!-- 备注 -->
			<view class="form-item">
				<text class="label">备注</text>
				<textarea class="textarea" v-model="remark" placeholder="请输入备注（可选）" />
			</view>

			<!-- 操作按钮 -->
			<view class="action-buttons">
				<view class="terminate-btn" @click="terminateEvent"><text class="action-btn-text">终止事件</text></view>
				<view class="save-btn" @click="saveEvent"><text class="action-btn-text save-btn-text">保存</text></view>
			</view>
		</view>

		<!-- 标签选择弹窗 -->
		<view class="modal selector-modal" v-if="showLabelSelector" @click="hideLabelModal">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">选择标签</text>
				</view>
				<scroll-view direction="vertical" class="modal-body selector-body">
					<view class="label-list">
						<view 
							class="label-item" 
							v-for="label in labels" 
							:key="label.id"
							:class="{ 'selected': selectedLabelIds.includes(label.id) }"
							@click.stop="toggleLabel(label.id)"
						>
							<view class="label-info">
								<view class="label-color" :style="{ backgroundColor: label.color }"></view>
								<text class="label-name">{{label.name}}</text>
							</view>
							<view class="label-check-wrap">
								<text class="label-check" :class="{ visible: selectedLabelIds.includes(label.id) }">✓</text>
							</view>
						</view>
					</view>
				</scroll-view>
				<view class="modal-footer">
					<button class="add-label-btn" @click.stop="showAddLabel">新增标签</button>
					<button class="confirm-btn" @click.stop="confirmLabels">确定</button>
				</view>
			</view>
		</view>

		<!-- 新增标签弹窗 -->
		<view class="modal add-label-modal" v-if="showAddLabelModal" @click="hideAddLabelModal">
			<view class="modal-content" @click.stop>
				<view class="modal-header">
					<text class="modal-title">新增标签</text>
				</view>
				<view class="modal-body">
					<view class="form-item">
						<text class="label">标签名称</text>
						<input class="input" v-model="newLabelName" placeholder="请输入标签名称" confirm-type="done" @input="clearNewLabelError" @confirm="addNewLabel" />
						<text class="error-tip" v-if="newLabelError">{{newLabelError}}</text>
					</view>
					<view class="form-item">
						<text class="label">标签颜色</text>
						<view class="color-options">
							<view 
								class="color-option" 
								v-for="color in colorOptions" 
								:key="color"
								:class="{ 'selected': newLabelColor === color }"
								:style="{ backgroundColor: color }"
								@click.stop="newLabelColor = color"
							>
								<text v-if="newLabelColor === color" class="check-icon">✓</text>
							</view>
						</view>
					</view>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideAddLabelModal">取消</button>
					<button class="confirm-btn" @click.stop="addNewLabel">确定</button>
				</view>
			</view>
		</view>

		<view class="modal date-modal" v-if="showDateSelector" @click="hideDateSelector">
			<view class="modal-content date-modal-content" @click.stop>
				<view class="modal-header date-modal-header">
					<text class="modal-title">选择日期</text>
				</view>
				<view class="date-calendar-header">
					<view class="date-nav-btn" @click.stop="prevDatePickerMonth"><text class="date-nav-text">‹</text></view>
					<text class="date-calendar-title">{{yearOptions[selectedYearIndex]}} 年 {{monthOptions[selectedMonthIndex]}} 月</text>
					<view class="date-nav-btn" @click.stop="nextDatePickerMonth"><text class="date-nav-text">›</text></view>
				</view>
				<view class="date-week-row">
					<text class="date-week-text" v-for="item in dateWeekdays" :key="item">{{item}}</text>
				</view>
				<view class="date-grid">
					<view
						class="date-day"
						v-for="(item, index) in datePickerDays"
						:key="index"
						:class="{ selected: item.isCurrentMonth && isSelectedDatePickerDay(item), muted: !item.isCurrentMonth }"
						@click.stop="selectDatePickerDay(item)"
					>
						<text class="date-day-text" :class="{ selected: item.isCurrentMonth && isSelectedDatePickerDay(item), muted: !item.isCurrentMonth }">{{item.day}}</text>
					</view>
				</view>
				<view class="modal-footer">
					<button class="cancel-btn" @click.stop="hideDateSelector">取消</button>
					<button class="confirm-btn" @click.stop="confirmDateSelector">确定</button>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { EventManager } from '@/utils/eventManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { Event, Label, RepeatUnit } from '@/utils/storage.uts'
	import { requestEventNotificationPermission } from '@/uni_modules/donelogWidget/utssdk'

	type IntervalUnitOption = {
		value: RepeatUnit
		label: string
	}

	type DatePickerDay = {
		year: number
		month: number
		day: number
		isCurrentMonth: boolean
	}

	// 响应式数据
	const eventId = ref(0)
	const currentEvent = ref<Event | null>(null)
	const eventName = ref('')
	const selectedLabelIds = ref<number[]>([])
	const labels = ref<Label[]>([])
	const repeatType = ref<'interval' | 'date' | 'single'>('interval')
	const intervalUnit = ref<RepeatUnit>('day')
	const intervalDays = ref('')
	const nextDueDate = ref('')
	const remark = ref('')
	const notifyEnabled = ref(false)
	const notifyTime = ref('09:00')
	const showLabelSelector = ref(false)
	const showAddLabelModal = ref(false)
	const showDateSelector = ref(false)
	const shouldRestoreLabelSelector = ref(false)
	const newLabelName = ref('')
	const newLabelError = ref('')
	const newLabelColor = ref('#007AFF')
	const selectedYearIndex = ref(0)
	const selectedMonthIndex = ref(0)
	const selectedDayIndex = ref(0)

	// 预设颜色选项
	const colorOptions = [
		'#007AFF', // 蓝色
		'#FF3B30', // 红色
		'#FF9500', // 橙色
		'#FFCC00', // 黄色
		'#4CD964', // 绿色
		'#5AC8FA', // 浅蓝
		'#5856D6', // 紫色
		'#FF2D55', // 粉色
		'#8E8E93', // 灰色
		'#34C759'  // 深绿
	]

	const intervalUnitOptions: IntervalUnitOption[] = [
		{ value: 'day', label: '按天' },
		{ value: 'month', label: '按月' },
		{ value: 'year', label: '按年' }
	]

	const createYearOptions = (): string[] => {
		const options: string[] = []
		const currentYear = new Date().getFullYear()
		for (let i = 0; i < 8; i++) {
			options.push(`${currentYear + i}`)
		}
		return options
	}

	const createMonthOptions = (): string[] => {
		const options: string[] = []
		for (let i = 1; i <= 12; i++) {
			options.push(`${i}`.padStart(2, '0'))
		}
		return options
	}

	const createDayOptions = (year: number, month: number): string[] => {
		const options: string[] = []
		const days = new Date(year, month, 0).getDate()
		for (let i = 1; i <= days; i++) {
			options.push(`${i}`.padStart(2, '0'))
		}
		return options
	}

	const createDatePickerDays = (year: number, month: number): DatePickerDay[] => {
		const days: DatePickerDay[] = []
		const firstDay = new Date(year, month - 1, 1)
		const lastDay = new Date(year, month, 0)
		const prevLastDay = new Date(year, month - 1, 0)
		const startWeekday = firstDay.getDay()

		for (let i = startWeekday - 1; i >= 0; i--) {
			days.push({
				year: month === 1 ? year - 1 : year,
				month: month === 1 ? 12 : month - 1,
				day: prevLastDay.getDate() - i,
				isCurrentMonth: false
			})
		}

		for (let i = 1; i <= lastDay.getDate(); i++) {
			days.push({
				year,
				month,
				day: i,
				isCurrentMonth: true
			})
		}

		const remainingDays = 42 - days.length
		for (let i = 1; i <= remainingDays; i++) {
			days.push({
				year: month === 12 ? year + 1 : year,
				month: month === 12 ? 1 : month + 1,
				day: i,
				isCurrentMonth: false
			})
		}

		return days
	}

	const yearOptions = createYearOptions()
	const monthOptions = createMonthOptions()
	const dateWeekdays = ['日', '一', '二', '三', '四', '五', '六']

	const getOptionString = (options: UTSJSONObject, key: string): string => {
		const value = options[key]
		return value != null ? `${value}` : ''
	}

	const getDetailObject = (e: UTSJSONObject): UTSJSONObject | null => {
		const detail = e['detail']
		return detail != null ? detail as UTSJSONObject : null
	}

	const getDetailStringValue = (e: UTSJSONObject, key: string): string => {
		const detail = getDetailObject(e)
		if (detail == null) return ''
		const value = detail[key]
		return value != null ? `${value}` : ''
	}

	const getDetailBooleanValue = (e: UTSJSONObject, key: string): boolean => {
		const detail = getDetailObject(e)
		if (detail == null) return false
		const value = detail[key]
		return value === true
	}

	const getSelectedYear = (): number => {
		return parseInt(yearOptions[selectedYearIndex.value])
	}

	const getSelectedMonth = (): number => {
		return parseInt(monthOptions[selectedMonthIndex.value])
	}

	const dayOptions = computed(() => createDayOptions(getSelectedYear(), getSelectedMonth()))
	const datePickerDays = computed(() => createDatePickerDays(getSelectedYear(), getSelectedMonth()))

	const getSelectedDay = (): number => {
		return parseInt(dayOptions.value[selectedDayIndex.value])
	}

	const formatDateParts = (year: number, month: number, day: number): string => {
		return `${year}-${`${month}`.padStart(2, '0')}-${`${day}`.padStart(2, '0')}`
	}

	const clampSelectedDay = () => {
		const maxIndex = dayOptions.value.length - 1
		if (selectedDayIndex.value > maxIndex) {
			selectedDayIndex.value = maxIndex
		}
	}

	const setDateSelectorValue = (date: Date) => {
		const year = `${date.getFullYear()}`
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')

		const yearIndex = yearOptions.indexOf(year)
		selectedYearIndex.value = yearIndex >= 0 ? yearIndex : 0
		const monthIndex = monthOptions.indexOf(month)
		selectedMonthIndex.value = monthIndex >= 0 ? monthIndex : 0
		clampSelectedDay()
		const dayIndex = dayOptions.value.indexOf(day)
		selectedDayIndex.value = dayIndex >= 0 ? dayIndex : 0
	}

	const isSelectedDatePickerDay = (item: DatePickerDay): boolean => {
		return item.year === getSelectedYear()
			&& item.month === getSelectedMonth()
			&& item.day === getSelectedDay()
	}

	const selectDatePickerDay = (item: DatePickerDay) => {
		const yearIndex = yearOptions.indexOf(`${item.year}`)
		if (yearIndex < 0) {
			return
		}
		selectedYearIndex.value = yearIndex
		selectedMonthIndex.value = item.month - 1
		clampSelectedDay()
		selectedDayIndex.value = Math.max(0, Math.min(dayOptions.value.length - 1, item.day - 1))
	}

	const prevDatePickerMonth = () => {
		if (selectedMonthIndex.value > 0) {
			selectedMonthIndex.value--
		} else if (selectedYearIndex.value > 0) {
			selectedYearIndex.value--
			selectedMonthIndex.value = 11
		}
		clampSelectedDay()
	}

	const nextDatePickerMonth = () => {
		if (selectedMonthIndex.value < 11) {
			selectedMonthIndex.value++
		} else if (selectedYearIndex.value < yearOptions.length - 1) {
			selectedYearIndex.value++
			selectedMonthIndex.value = 0
		}
		clampSelectedDay()
	}

	const intervalFieldLabel = computed(() => {
		if (intervalUnit.value === 'month') {
			return '间隔月数'
		}
		if (intervalUnit.value === 'year') {
			return '间隔年数'
		}
		return '间隔天数'
	})

	const intervalPlaceholder = computed(() => {
		if (intervalUnit.value === 'month') {
			return '1 表示每 1 个月'
		}
		if (intervalUnit.value === 'year') {
			return '1 表示每 1 年'
		}
		return '0 表示明天，1 表示后天'
	})

	const intervalHelperText = computed(() => {
		if (intervalUnit.value === 'month') {
			return '按自然月推进：1 表示下个月同一天再次需要完成。'
		}
		if (intervalUnit.value === 'year') {
			return '按自然年推进：1 表示明年同一天再次需要完成。'
		}
		return '按“中间空几天”计算：0 表示明天再次需要完成。'
	})

	const showIntervalSettings = computed(() => repeatType.value === 'interval')
	const showDateSettings = computed(() => repeatType.value === 'date')

	// 格式化日期
	const formatDate = (timestamp: number): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')
		return `${year}-${month}-${day}`
	}

	// 加载事件数据
	const loadEventData = () => {
		const event = EventManager.getEventById(eventId.value)
		if (event == null) {
			uni.showToast({
				title: '事件不存在',
				icon: 'none'
			})
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
			return
		}

		currentEvent.value = event
		eventName.value = event.name
		const validLabelIds = labels.value.map(label => label.id)
		selectedLabelIds.value = event.labelIdList
			.split(',')
			.map(id => parseInt(id))
			.filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
		remark.value = event.remark
		notifyEnabled.value = event.notifyEnabled
		notifyTime.value = event.notifyTime

		if (event.nextDueDate > 0) {
			repeatType.value = 'date'
			nextDueDate.value = formatDate(event.nextDueDate)
		} else if (event.intervalDays >= 0) {
			repeatType.value = 'interval'
			intervalUnit.value = event.repeatUnit
			intervalDays.value = `${event.intervalDays}`
		} else {
			repeatType.value = 'single'
			intervalUnit.value = 'day'
		}
	}

	// 加载标签列表
	const loadLabels = () => {
		labels.value = LabelManager.getSortedLabels('event')
	}

	// 切换标签选择
	const toggleLabel = (labelId: number) => {
		selectedLabelIds.value = selectedLabelIds.value.includes(labelId) ? [] : [labelId]
	}

	// 显示标签选择弹窗
	const showLabelModal = () => {
		showLabelSelector.value = true
	}

	// 隐藏标签选择弹窗
	const hideLabelModal = () => {
		showLabelSelector.value = false
	}

	// 确认标签选择
	const confirmLabels = () => {
		hideLabelModal()
	}

	// 显示新增标签弹窗
	const showAddLabel = () => {
		newLabelName.value = ''
		newLabelError.value = ''
		newLabelColor.value = '#007AFF'
		shouldRestoreLabelSelector.value = showLabelSelector.value
		showLabelSelector.value = false
		showAddLabelModal.value = true
	}

	const closeAddLabelModal = (restoreSelector: boolean) => {
		showAddLabelModal.value = false
		newLabelError.value = ''
		if (restoreSelector && shouldRestoreLabelSelector.value) {
			showLabelSelector.value = true
		}
		shouldRestoreLabelSelector.value = false
	}

	const clearNewLabelError = () => {
		if (newLabelError.value.length > 0) {
			newLabelError.value = ''
		}
	}

	const selectIntervalUnit = (unit: RepeatUnit) => {
		intervalUnit.value = unit
	}

	const selectRepeatType = (type: 'interval' | 'date' | 'single') => {
		repeatType.value = type
	}

	// 隐藏新增标签弹窗
	const hideAddLabelModal = () => {
		closeAddLabelModal(true)
	}

	// 新增标签
	const addNewLabel = () => {
		const createdName = newLabelName.value.trim()
		if (createdName.length === 0) {
			newLabelError.value = '请输入标签名称'
			uni.showToast({
				title: '请输入标签名称',
				icon: 'none'
			})
			return
		}

		const existingLabel = LabelManager.getLabelByName(createdName, 'event')
		if (existingLabel != null) {
			selectedLabelIds.value = [existingLabel.id]
			newLabelError.value = '已存在同名标签，已为你选中'
			uni.showToast({
				title: '标签已存在，已选中',
				icon: 'none'
			})
			return
		}

		const success = LabelManager.addLabel(createdName, newLabelColor.value, 'event')
		if (success == true) {
			newLabelName.value = ''
			newLabelError.value = ''
			newLabelColor.value = '#007AFF'
			uni.showToast({
				title: '添加成功',
				icon: 'success'
			})
			loadLabels()
			const created = labels.value.find(item => item.name === createdName)
			if (created != null) selectedLabelIds.value = [created.id]
			closeAddLabelModal(true)
		} else {
			newLabelError.value = '添加失败，请稍后再试'
			uni.showToast({
				title: '添加失败',
				icon: 'none'
			})
		}
	}

	// 获取标签名称
	const getLabelName = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.name : ''
	}

	// 获取标签颜色
	const getLabelColor = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.color : '#007AFF'
	}

	const openDateSelector = () => {
		if (nextDueDate.value.length > 0) {
			setDateSelectorValue(new Date(nextDueDate.value))
		} else {
			setDateSelectorValue(new Date(Date.now() + 24 * 60 * 60 * 1000))
		}
		showDateSelector.value = true
	}

	const hideDateSelector = () => {
		showDateSelector.value = false
	}

	const confirmDateSelector = () => {
		nextDueDate.value = formatDateParts(getSelectedYear(), getSelectedMonth(), getSelectedDay())
		hideDateSelector()
	}

	const onNotifyEnabledChange = (e: UTSJSONObject) => {
		notifyEnabled.value = getDetailBooleanValue(e, 'value')
		if (notifyEnabled.value) {
			requestEventNotificationPermission()
		}
	}

	const onNotifyTimeChange = (e: UTSJSONObject) => {
		const value = getDetailStringValue(e, 'value')
		if (value.length > 0) {
			notifyTime.value = value
		}
	}

	// 保存事件
	const saveEvent = () => {
		if (eventName.value.trim().length === 0) {
			uni.showToast({
				title: '请输入事件名称',
				icon: 'none'
			})
			return
		}

		if (repeatType.value === 'interval' && intervalDays.value.length === 0) {
			uni.showToast({
				title: '请输入间隔天数',
				icon: 'none'
			})
			return
		}

		if (repeatType.value === 'interval') {
			const interval = parseInt(intervalDays.value)
			if (Number.isNaN(interval)) {
				uni.showToast({
					title: '请输入有效的间隔值',
					icon: 'none'
				})
				return
			}

			if (intervalUnit.value === 'day' && interval < 0) {
				uni.showToast({
					title: '间隔天数不能小于 0',
					icon: 'none'
				})
				return
			}

			if ((intervalUnit.value === 'month' || intervalUnit.value === 'year') && interval < 1) {
				uni.showToast({
					title: intervalUnit.value === 'month' ? '间隔月数至少为 1' : '间隔年数至少为 1',
					icon: 'none'
				})
				return
			}
		}

		if (repeatType.value === 'date' && nextDueDate.value.length === 0) {
			uni.showToast({
				title: '请选择下次完成时间',
				icon: 'none'
			})
			return
		}

		if (currentEvent.value == null) {
			uni.showToast({
				title: '事件不存在',
				icon: 'none'
			})
			return
		}

		const event: Event = {
			id: eventId.value,
			name: eventName.value,
			labelIdList: selectedLabelIds.value.join(','),
			intervalDays: repeatType.value === 'interval' ? parseInt(intervalDays.value) : (repeatType.value === 'single' ? -1 : 0),
			repeatUnit: repeatType.value === 'interval' ? intervalUnit.value : 'day',
			nextDueDate: repeatType.value === 'date' ? new Date(nextDueDate.value).getTime() : 0,
			remark: remark.value,
			isTerminated: currentEvent.value.isTerminated,
			terminatedAt: currentEvent.value.terminatedAt,
			notifyEnabled: notifyEnabled.value,
			notifyTime: notifyTime.value,
			createTime: currentEvent.value.createTime,
			updateTime: currentEvent.value.updateTime
		}

		const success = EventManager.updateEvent(event)
		if (success == true) {
			uni.showToast({
				title: '保存成功',
				icon: 'success'
			})
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
		} else {
			uni.showToast({
				title: '保存失败',
				icon: 'none'
			})
		}
	}

	// 终止事件
	const terminateEvent = () => {
		uni.showModal({
			title: '确认终止',
			content: '确定要终止这个事件吗？终止后事件将不再显示在列表中。',
			success: (res) => {
				if (res.confirm == true) {
					const success = EventManager.terminateEvent(eventId.value)
					if (success == true) {
						uni.showToast({
							title: '已终止',
							icon: 'success'
						})
						setTimeout(() => {
							uni.navigateBack()
						}, 1500)
					} else {
						uni.showToast({
							title: '终止失败',
							icon: 'none'
						})
					}
				}
			}
		})
	}

	// 页面加载时获取数据
	onLoad((options: UTSJSONObject) => {
		const id = getOptionString(options, 'id')
		if (id.length > 0) {
			eventId.value = parseInt(id)
			loadLabels()
			loadEventData()
		} else {
			uni.showToast({
				title: '参数错误',
				icon: 'none'
			})
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
		}
	})
</script>

