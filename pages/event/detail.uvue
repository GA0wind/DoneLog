<template>
	<scroll-view direction="vertical" style="flex: 1" class="container">
		<!-- 事件信息卡片 -->
		<view class="event-info" v-if="hasEvent">
			<view class="event-header">
				<text class="event-name">{{eventName}}</text>
				<view class="event-status" :class="{ 'overdue': isOverdue }">
					<text class="status-text" :class="{ overdue: isOverdue }">{{statusText}}</text>
				</view>
			</view>

			<view class="event-tags">
				<text 
					class="tag" 
					v-for="labelId in getEventLabelIds()" 
					:key="labelId"
					:style="{ backgroundColor: getLabelColor(labelId) }"
				>
					{{getLabelName(labelId)}}
				</text>
			</view>

			<view class="event-details">
				<view class="detail-item" v-if="showIntervalRepeat">
					<text class="detail-label">重复方式：</text>
					<text class="detail-value">{{intervalRepeatText}}</text>
				</view>
				<view class="detail-item" v-if="showSingleReminder">
					<text class="detail-label">重复方式：</text>
					<text class="detail-value">不重复，每天提醒直到完成</text>
				</view>
				<view class="detail-item" v-if="showNextDueDate">
					<text class="detail-label">下次完成时间：</text>
					<text class="detail-value">{{formatDate(eventNextDueDate)}}</text>
				</view>
				<view class="detail-item" v-if="showNotification">
					<text class="detail-label">提醒时间：</text>
					<text class="detail-value">{{eventNotifyTime}}</text>
				</view>
				<view class="detail-item" v-if="showRemark">
					<text class="detail-label">备注：</text>
					<text class="detail-value">{{eventRemark}}</text>
				</view>
				<view class="detail-item">
					<text class="detail-label">创建时间：</text>
					<text class="detail-value">{{formatDateTime(eventCreateTime)}}</text>
				</view>
			</view>

			<view class="focus-card" v-if="canComplete" @click="startPomodoro">
				<view class="focus-copy">
					<text class="focus-title">专注推进这个事件</text>
					<text class="focus-desc">开启一个番茄钟，完成后再回来标记完成。</text>
				</view>
				<text class="focus-action">开始番茄钟</text>
			</view>

			<view class="event-actions">
				<view class="action-btn edit-btn" @click="goToEdit"><text class="action-btn-text edit-btn-text">编辑</text></view>
				<view class="action-btn duplicate-btn" @click="duplicateEvent"><text class="action-btn-text duplicate-btn-text">复制</text></view>
				<view class="action-btn complete-btn" v-if="canComplete" @click="markComplete"><text class="action-btn-text complete-btn-text">完成</text></view>
			</view>
		</view>
		<view class="event-info" v-if="!hasEvent">
			<text class="empty-title">事件不存在或已被删除</text>
		</view>

		<!-- 历史记录 -->
		<view class="history-section">
			<view class="section-header">
				<text class="section-title">完成记录</text>
			</view>
			<scroll-view direction="vertical" class="history-list">
				<view class="history-item" v-for="record in historyRecords" :key="record.id">
					<view class="history-dot"></view>
					<view class="history-content">
						<text class="history-date">{{formatDateTime(record.lastCompleteDate)}}</text>
						<text class="history-time">{{getTimeText(record.lastCompleteDate)}}</text>
					</view>
				</view>
				<view class="empty-tip" v-if="historyRecords.length === 0">
					<text>暂无完成记录</text>
				</view>
			</scroll-view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { EventManager } from '@/utils/eventManager.uts'
	import { LabelManager } from '@/utils/labelManager.uts'
	import { Event, Label, CompletionRecord, RepeatUnit } from '@/utils/storage.uts'

	const eventId = ref(0)
	const currentEvent = ref<Event | null>(null)
	const hasLoadedEvent = ref(false)
	const eventName = ref('')
	const eventLabelIdList = ref('')
	const eventIntervalDays = ref(0)
	const eventRepeatUnit = ref<RepeatUnit>('day')
	const eventNextDueDate = ref(0)
	const eventRemark = ref('')
	const eventCreateTime = ref(0)
	const eventIsTerminated = ref(false)
	const eventNotifyEnabled = ref(false)
	const eventNotifyTime = ref('09:00')
	const labels = ref<Label[]>([])
	const historyRecords = ref<CompletionRecord[]>([])

	const getOptionString = (options: UTSJSONObject, key: string): string => {
		const value = options[key]
		return value != null ? `${value}` : ''
	}

	const hasEvent = computed(() => hasLoadedEvent.value)

	const showIntervalRepeat = computed(() => {
		return hasLoadedEvent.value && eventIntervalDays.value >= 0 && eventNextDueDate.value <= 0
	})

	const showSingleReminder = computed(() => {
		return hasLoadedEvent.value && eventIntervalDays.value < 0 && eventNextDueDate.value <= 0
	})

	const showNextDueDate = computed(() => {
		return hasLoadedEvent.value && eventNextDueDate.value > 0
	})

	const showRemark = computed(() => {
		return hasLoadedEvent.value && eventRemark.value.length > 0
	})

	const showNotification = computed(() => {
		return hasLoadedEvent.value && eventNotifyEnabled.value
	})

	const intervalRepeatText = computed(() => {
		if (hasLoadedEvent.value == false) return ''
		if (eventRepeatUnit.value === 'month') return `每 ${eventIntervalDays.value} 个月`
		if (eventRepeatUnit.value === 'year') return `每 ${eventIntervalDays.value} 年`
		if (eventIntervalDays.value === 0) return '按天，明天再次完成'
		return `按天，中间空 ${eventIntervalDays.value} 天`
	})

	const getCurrentEvent = (): Event | null => {
		return currentEvent.value
	}

	const isOverdue = computed(() => {
		const event = getCurrentEvent()
		if (event == null) return false
		const latestRecord = historyRecords.value.length > 0 ? historyRecords.value[0] : null
		if (EventManager.isFixedDateCompleted(event, latestRecord != null ? latestRecord.lastCompleteDate : null)) {
			return false
		}
		const daysUntilDue = EventManager.calculateDaysUntilDue(event, latestRecord != null ? latestRecord.lastCompleteDate : null)
		return daysUntilDue < 0
	})

	const canComplete = computed(() => {
		const event = getCurrentEvent()
		if (event == null) return false
		if (eventIsTerminated.value) return false
		if (EventManager.isCompletedOnDate(event.id, Date.now())) return false
		const latestRecord = historyRecords.value.length > 0 ? historyRecords.value[0] : null
		return EventManager.isFixedDateCompleted(event, latestRecord != null ? latestRecord.lastCompleteDate : null) == false
	})

	const statusText = computed(() => {
		const event = getCurrentEvent()
		if (event == null) return ''
		if (EventManager.isCompletedOnDate(event.id, Date.now())) return '已完成'

		const lastRecord = historyRecords.value.length > 0 ? historyRecords.value[0] : null
		if (EventManager.isFixedDateCompleted(event, lastRecord != null ? lastRecord.lastCompleteDate : null)) {
			return '已完成'
		}
		if (eventIsTerminated.value) return '已终止'

		const daysUntilDue = EventManager.calculateDaysUntilDue(event, lastRecord != null ? lastRecord.lastCompleteDate : null)
		if (daysUntilDue === 0) return '今天'
		if (daysUntilDue === 1) return '明天'
		if (daysUntilDue === -1) return '昨天'
		if (daysUntilDue < 0) return `已过期 ${Math.abs(daysUntilDue)} 天`
		return `还有 ${daysUntilDue} 天`
	})

	const formatDate = (timestamp: number): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')
		return `${year}-${month}-${day}`
	}

	const formatDateTime = (timestamp: number): string => {
		const date = new Date(timestamp)
		const year = date.getFullYear()
		const month = `${date.getMonth() + 1}`.padStart(2, '0')
		const day = `${date.getDate()}`.padStart(2, '0')
		const hours = `${date.getHours()}`.padStart(2, '0')
		const minutes = `${date.getMinutes()}`.padStart(2, '0')
		return `${year}-${month}-${day} ${hours}:${minutes}`
	}

	const getEventLabelIds = (): number[] => {
		if (hasLoadedEvent.value == false || eventLabelIdList.value.length === 0) return []
		const validLabelIds = labels.value.map(label => label.id)
		return eventLabelIdList.value
			.split(',')
			.map(id => parseInt(id))
			.filter(id => !Number.isNaN(id) && validLabelIds.includes(id))
	}

	const getTimeText = (timestamp: number): string => {
		const date = new Date(timestamp)
		const hours = `${date.getHours()}`.padStart(2, '0')
		const minutes = `${date.getMinutes()}`.padStart(2, '0')
		return `${hours}:${minutes}`
	}

	const getLabelName = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.name : ''
	}

	const getLabelColor = (labelId: number): string => {
		const label = labels.value.find(l => l.id === labelId)
		return label != null ? label.color : '#007AFF'
	}

	const goToEdit = () => {
		if (hasLoadedEvent.value == false) return
		uni.navigateTo({
			url: `/pages/event/edit?id=${eventId.value}`
		})
	}

	const duplicateEvent = () => {
		if (hasLoadedEvent.value == false) return
		const newEventId = EventManager.duplicateEvent(eventId.value)
		if (newEventId <= 0) {
			uni.showToast({
				title: '复制失败',
				icon: 'none'
			})
			return
		}

		uni.showToast({
			title: '已复制',
			icon: 'success'
		})
		setTimeout(() => {
			uni.navigateTo({
				url: `/pages/event/edit?id=${newEventId}`
			})
		}, 800)
	}

	const startPomodoro = () => {
		if (hasLoadedEvent.value == false) return
		uni.navigateTo({
			url: `/pages/pomodoro/index?eventId=${eventId.value}&autoStart=1`
		})
	}

	const resetEventView = () => {
		currentEvent.value = null
		hasLoadedEvent.value = false
		eventName.value = ''
		eventLabelIdList.value = ''
		eventIntervalDays.value = 0
		eventRepeatUnit.value = 'day'
		eventNextDueDate.value = 0
		eventRemark.value = ''
		eventCreateTime.value = 0
		eventIsTerminated.value = false
		eventNotifyEnabled.value = false
		eventNotifyTime.value = '09:00'
	}

	const applyEventView = (event: Event) => {
		currentEvent.value = event
		hasLoadedEvent.value = true
		eventName.value = event.name
		eventLabelIdList.value = event.labelIdList
		eventIntervalDays.value = event.intervalDays
		eventRepeatUnit.value = event.repeatUnit
		eventNextDueDate.value = event.nextDueDate
		eventRemark.value = event.remark
		eventCreateTime.value = event.createTime
		eventIsTerminated.value = event.isTerminated
		eventNotifyEnabled.value = event.notifyEnabled
		eventNotifyTime.value = event.notifyTime
	}

	const loadEventData = () => {
		if (eventId.value <= 0) return
		try {
			const loadedEvent = EventManager.getEventById(eventId.value)
			if (loadedEvent == null) {
				resetEventView()
			} else {
				applyEventView(loadedEvent)
			}
			labels.value = LabelManager.getSortedLabels('event')
			historyRecords.value = EventManager.getEventHistory(eventId.value)
		} catch (error) {
			resetEventView()
			labels.value = []
			historyRecords.value = []
		}
	}

	const markComplete = () => {
		const event = getCurrentEvent()
		if (event == null) return
		if (event.nextDueDate > 0) {
			uni.navigateTo({
				url: `/pages/event/complete?id=${eventId.value}`
			})
			return
		}

		const success = EventManager.markEventComplete(eventId.value)
		if (success == false) {
			uni.showToast({
				title: '今天已完成过或事件不可操作',
				icon: 'none'
			})
			return
		}

		if (event.intervalDays < 0) {
			EventManager.terminateEvent(eventId.value)
		}
		uni.showToast({
			title: '已完成',
			icon: 'success'
		})
		loadEventData()
	}

	onLoad((options: UTSJSONObject) => {
		const id = getOptionString(options, 'id')
		if (id.length > 0) {
			eventId.value = parseInt(id)
			loadEventData()
		} else {
			uni.showToast({
				title: '参数错误',
				icon: 'none'
			})
			setTimeout(() => {
				uni.navigateBack()
			}, 1500)
		}
	})

	onShow(() => {
		if (eventId.value > 0) {
			loadEventData()
		}
	})
</script>

<style>
	.container {
		background-color: #f4efe7;
		flex: 1;
		padding: 15px;
	}

	/* 事件信息卡片 */
	.event-info {
		background-color: #fffaf3;
		border-radius: 24px;
		padding: 18px;
		margin-bottom: 15px;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
		box-shadow: 0 12px 28px rgba(36, 50, 58, 0.06);
	}

	.event-header {
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 15px;
	}

	.event-name {
		font-size: 20px;
		font-weight: bold;
		color: #24323a;
		flex: 1;
	}

	.event-status {
		padding: 6px 12px;
		border-radius: 999px;
		background-color: #e8f4f2;
	}

	.event-status.overdue {
		background-color: #f8ddd3;
	}

	.status-text {
		font-size: 12px;
		color: #1f7a72;
	}

	.status-text.overdue {
		color: #c45d42;
	}

	.event-tags {
		flex-direction: row;
		flex-wrap: wrap;
		margin-bottom: 15px;
	}

	.tag {
		font-size: 12px;
		color: #fff;
		padding: 2px 8px;
		border-radius: 10px;
		margin-right: 5px;
		margin-bottom: 5px;
	}

	.event-details {
		border-top: 1px solid #f0f0f0;
		padding-top: 15px;
		margin-bottom: 15px;
	}

	.detail-item {
		flex-direction: row;
		margin-bottom: 8px;
	}

	.detail-label {
		font-size: 14px;
		color: #72808d;
		width: 120px;
	}

	.detail-value {
		font-size: 14px;
		color: #24323a;
		flex: 1;
	}

	.event-actions {
		flex-direction: row;
		justify-content: space-between;
	}

	.focus-card {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		background: linear-gradient(135deg, #24323a, #5d7fa3);
		border-radius: 18px;
		padding: 14px;
		margin-bottom: 14px;
		box-shadow: 0 12px 24px rgba(93, 127, 163, 0.18);
	}

	.focus-copy {
		flex: 1;
		min-width: 0;
	}

	.focus-title {
		font-size: 15px;
		font-weight: bold;
		color: #fff9f2;
		margin-bottom: 5px;
	}

	.focus-desc {
		font-size: 12px;
		color: #d8e6e3;
		line-height: 1.4;
	}

	.focus-action {
		flex-shrink: 0;
		font-size: 12px;
		font-weight: 600;
		color: #fff9f2;
		background-color: rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		padding: 8px 10px;
		margin-left: 12px;
	}

	.action-btn {
		flex: 1;
		height: 40px;
		border-radius: 20px;
		justify-content: center;
		align-items: center;
	}

	.action-btn-text {
		font-size: 14px;
		line-height: 40px;
	}

	.edit-btn {
		background-color: #fffdf9;
		border-width: 1px;
		border-style: solid;
		border-color: #e7ddd2;
		margin-right: 8px;
	}

	.edit-btn-text,
	.duplicate-btn-text {
		color: #4d5b67;
	}

	.duplicate-btn {
		background-color: #f2ebe2;
		margin-left: 4px;
		margin-right: 4px;
	}

	.complete-btn {
		background-color: #1f7a72;
		margin-left: 8px;
		box-shadow: 0 12px 22px rgba(31, 122, 114, 0.18);
	}

	.complete-btn-text {
		color: #fff;
	}

	.empty-title {
		font-size: 16px;
		color: #72808d;
		text-align: center;
	}

	/* 历史记录区域 */
	.history-section {
		background-color: #fffaf3;
		border-radius: 24px;
		padding: 18px;
		border-width: 1px;
		border-style: solid;
		border-color: #eadfd2;
		box-shadow: 0 12px 28px rgba(36, 50, 58, 0.05);
	}

	.section-header {
		margin-bottom: 15px;
	}

	.section-title {
		font-size: 16px;
		font-weight: bold;
		color: #24323a;
	}

	.history-list {
		max-height: 400px;
	}

	.history-item {
		flex-direction: row;
		padding: 10px 0;
		position: relative;
	}

	.history-dot {
		width: 10px;
		height: 10px;
		background-color: #1f7a72;
		border-radius: 5px;
		margin-right: 15px;
		margin-top: 5px;
	}

	.history-content {
		flex: 1;
		flex-direction: column;
	}

	.history-date {
		font-size: 14px;
		color: #24323a;
		margin-bottom: 4px;
	}

	.history-time {
		font-size: 12px;
		color: #999;
	}

	.empty-tip {
		text-align: center;
		padding: 30px 0;
		color: #999;
	}
</style>
